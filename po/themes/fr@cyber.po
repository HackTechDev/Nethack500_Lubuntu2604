# Cinquième lot : messages sur les stims, puces, implants, modules,
# logiciels et la monnaie

msgctxt "quest"
msgid "\"Can you spare an old cutpurse a zorkmid for some grog?\""
msgstr "« Tu n'aurais pas un crédit pour un vieux coupe-bourse qui a soif ? »"

msgctxt "quest"
msgid "\"Gehennom on 5 zorkmids a day -- more like 500 a day if you ask me.\""
msgstr "« La Géhennom pour 5 crédits par jour -- plutôt 500 par jour, si tu veux mon avis. »"

msgctxt "quest"
msgid "\"Hey man, got any potions of hallucination for sale?\""
msgstr "« Dis donc, t'aurais pas des stims d'hallucination à vendre ? »"

msgctxt "quest"
msgid "\"I shall use your very skin to bind my next grimoire.\""
msgstr "« Je tannerai ta propre peau pour gainer mon prochain terminal. »"

msgctxt "quest"
msgid "\"I will put my %Rp to work making a physic out of your ashes.\""
msgstr "« Je mettrai mes %Rp au travail pour tirer un stim de tes cendres. »"

msgid "As you cogitate the formula on it, the scroll disappears."
msgstr "Tandis que vous méditez son code, la puce grille."

msgid "As you pronounce the formula on it, the scroll disappears."
msgstr "Tandis que vous exécutez son code, la puce grille."

msgid "As you read the scroll, it disappears."
msgstr "Pendant que vous lisez la puce, elle grille."

msgid "Some potions spill out."
msgstr "Des stims s'en échappent."

msgid "The ink in this spellbook is %s."
msgstr "Le code de ce logiciel est %s."

msgid "The potion explodes!"
msgstr "Le stim explose !"

msgid "The scroll turns to dust as you pick it up."
msgstr "La puce tombe en poussière quand vous la ramassez."

msgid "The scrolls turn to dust as you pick them up."
msgstr "Les puces tombent en poussière quand vous les ramassez."

msgid "There is a message on this scroll."
msgstr "Il y a un message sur cette puce."

msgid "This spellbook has nothing written in it."
msgstr "Ce logiciel est vide."

msgid "You cannot take off your %s to remove the ring."
msgstr "Vous ne pouvez pas retirer vos %s pour retirer le module."

msgid "You cogitate the formula on the scroll."
msgstr "Vous méditez le code de la puce."

msgid "You pronounce the formula on the scroll."
msgstr "Vous exécutez le code de la puce."

msgid "Your left ring sears %s!"
msgstr "Votre module gauche brûle %s !"

msgid "Your right ring sears %s!"
msgstr "Votre module droit brûle %s !"

msgid "Your silver ring sears %s!"
msgstr "Votre module d'argent brûle %s !"

msgid "Your silver rings sear %s!"
msgstr "Vos modules d'argent brûlent %s !"

msgid "Pick up this scroll, read it with '%s', and try to remove the armor again"
msgstr "Ramassez cette puce, lisez-la avec “%s”, puis essayez de nouveau d'ôter l'armure"

msgid "Magic wands are used with '%s'"
msgstr "On utilise les implants avec “%s”"

msgid "Pick up the spellbook with '%s'"
msgstr "Ramassez le logiciel avec “%s”"

msgid "Read the spellbook with '%s'"
msgstr "Lisez le logiciel avec “%s”"

msgid "You \"quaff\" potions with '%s'"
msgstr "Vous buvez les stims avec “%s”"

msgid "You snuff the lit potion."
msgstr "Vous éteignez le stim allumé."

msgid "That's in addition to the cost of the potion, of course."
msgstr "C'est en plus du prix du stim, bien entendu."

msgid "This spellbook doesn't have much of a plot."
msgstr "Ce logiciel n'a pas vraiment de scénario."

msgid "The magical ink in this spellbook is %s."
msgstr "Le code magique de ce logiciel est %s."

msgid "put on an accessory (ring, amulet, etc)"
msgstr "mettre un accessoire (module, amulette, etc.)"

msgid "read a scroll or spellbook"
msgstr "lire une puce ou un logiciel"

msgid "remove an accessory (ring, amulet, etc)"
msgstr "retirer un accessoire (module, amulette, etc.)"

msgid "show the ring(s) currently worn"
msgstr "afficher le ou les modules portés"

msgid "zap a wand"
msgstr "utiliser un implant"

msgid "rings"
msgstr "modules"

msgid "potions"
msgstr "stims"

msgid "scrolls"
msgstr "puces"

msgid "spellbooks"
msgstr "logiciels"

msgid "wands"
msgstr "implants"

msgid "The ring is regurgitated!"
msgstr "Le module est régurgité !"

msgid "You see the ring slide right down the drain!"
msgstr "Vous voyez le module glisser dans le siphon !"

