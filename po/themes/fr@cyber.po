# Septième lot : les quêtes (msgctxt quest).  Textes communs

msgctxt "quest"
msgid "\"Repent, and thou shalt be saved!\""
msgstr "« Mets-toi à jour, et tu seras sauvé{|e} ! »"

msgctxt "quest"
msgid "\"Thou shalt pay for thine insolence!\""
msgstr "« Ton insolence vient d'être enregistrée.  Tu paieras ! »"

msgctxt "quest"
msgid "\"Very soon, my child, thou shalt meet thy maker.\""
msgstr "« Très bientôt, mon enfant, tu rencontreras ton développeur. »"

msgctxt "quest"
msgid "\"The great %D has sent me to make you pay for your sins!\""
msgstr "« %D, dans sa grandeur, m'a téléchargé ici pour te faire payer tes péchés ! »"

msgctxt "quest"
msgid "\"The wrath of %D is now upon you!\""
msgstr "« La colère de %D s'abat maintenant sur toi, en haute définition ! »"

msgctxt "quest"
msgid "\"Thy life belongs to %D now!\""
msgstr "« Ta licence de vie est révoquée par %D ! »"

msgctxt "quest"
msgid "\"Dost thou wish to receive thy final blessing?\""
msgstr "« Désires-tu recevoir ta dernière mise à jour ? »"

msgctxt "quest"
msgid "\"Thou art but a godless void.\""
msgstr "« Tu n'es qu'un processus sans maître. »"

msgctxt "quest"
msgid "\"Thou art not worthy to seek the Amulet.\""
msgstr "« Tu n'as pas les droits d'accès à l'Amulette. »"

msgctxt "quest"
msgid "\"No one expects the Spanish Inquisition!\""
msgstr "« Personne ne s'attend à l'audit de sécurité ! »"

msgctxt "quest"
msgid "\"Judgment hath been passed upon thee, %p.\""
msgstr "« Le jugement a été prononcé contre toi, %p.  Sans appel. »"

msgctxt "quest"
msgid "\"Thy reckoning is at hand, %p.\""
msgstr "« L'heure de solder tes comptes est venue, %p. »"

msgctxt "quest"
msgid "\"Thou shalt be brought before %D for thy crimes!\""
msgstr "« Tu seras traîné{|e} devant %D pour tes crimes, menottes aux poignets ! »"

msgctxt "quest"
msgid "\"With %D as my witness, I shall strike thee down.\""
msgstr "« %D m'en est témoin, je vais te supprimer. »"

msgctxt "quest"
msgid "[You are banished from %H for betraying your allegiance to %d.]"
msgstr "[Vous êtes radié{|e} @de %H pour avoir trahi votre allégeance à %d.]"

msgctxt "quest"
msgid ""
"\"You have betrayed all those who hold allegiance to %d, as you once did.\n"
"My allegiance to %d holds fast and I cannot condone or accept what you\n"
"have done.\n"
"\n"
"Leave this place.  You shall never set foot at %H again.\n"
"That which you seek is now lost forever, for without the Bell of Opening,\n"
"you will never be able to enter the place where he who has the Amulet\n"
"resides.\n"
"\n"
"Go now!  You are banished from this place."
msgstr ""
"« Vous avez trahi tous ceux qui ont juré fidélité à %d, comme vous\n"
"l'aviez fait autrefois.  Ma fidélité à %d ne se négocie pas, et je\n"
"ne peux ni excuser ni accepter ce que vous avez fait.\n"
"\n"
"Sortez d'ici.  Votre badge ne vous ouvrira plus jamais les portes @de %H.\n"
"Ce que vous cherchez est perdu pour toujours : sans la Cloche\n"
"d'Ouverture, vous n'entrerez jamais là où se cache celui qui détient\n"
"l'Amulette.\n"
"\n"
"Dehors !  Votre contrat est résilié. »"

msgctxt "quest"
msgid "\"I first mistook thee for a statue, when I regarded thy head of stone.\""
msgstr "« Je t'ai d'abord pris{|e} pour une statue, avec ta tête de béton. »"

msgctxt "quest"
msgid "\"Come here often?\""
msgstr "« Tu viens souvent dans ce secteur ? »"

msgctxt "quest"
msgid "\"Doth pain excite thee?  Wouldst thou prefer the whip?\""
msgstr "« La douleur te plaît ?  Tu préfères la matraque électrique ? »"

msgctxt "quest"
msgid "\"Thinkest thou it shall tickle as I rip out thy lungs?\""
msgstr "« Tu crois que ça va chatouiller quand je te débrancherai les poumons ? »"

msgctxt "quest"
msgid "\"Eat slime and die!\""
msgstr "« Bouffe de la boue toxique et crève ! »"

msgctxt "quest"
msgid "\"Go ahead, fetch thy mama!  I shall wait.\""
msgstr "« Vas-y, appelle ta maman !  J'attends. »"

msgctxt "quest"
msgid "\"Go play leapfrog with a herd of unicorns!\""
msgstr "« Va jouer à la marelle sur une autoroute ! »"

msgctxt "quest"
msgid "\"Hast thou been drinking, or art thou always so clumsy?\""
msgstr "« T'as trop bu de stims, ou t'es toujours aussi maladroit{|e} ? »"

msgctxt "quest"
msgid "\"This time I shall let thee off with a spanking, but let it not happen again.\""
msgstr "« Pour cette fois, je te laisse partir avec un avertissement.  Ne recommence pas. »"

msgctxt "quest"
msgid "\"I've met smarter (and prettier) acid blobs.\""
msgstr "« J'ai connu des blobs acides plus malins (et plus jolis). »"

msgctxt "quest"
msgid "\"Look!  Thy bootlace is undone!\""
msgstr "« Regarde !  Ton lacet est défait ! »"

msgctxt "quest"
msgid "\"Mercy!  Dost thou wish me to die of laughter?\""
msgstr "« Pitié !  Tu veux que je meure de rire ? »"

msgctxt "quest"
msgid "\"Run away!  Live to flee another day!\""
msgstr "« Cours !  Cours et vis assez longtemps pour fuir encore ! »"

msgctxt "quest"
msgid "\"Thou hadst best fight better than thou canst dress!\""
msgstr "« J'espère que tu te bats mieux que tu ne t'habilles ! »"

msgctxt "quest"
msgid "\"Twixt thy cousin and thee, Medusa is the prettier.\""
msgstr "« Entre ta cousine et toi, c'est Méduse la plus jolie. »"

msgctxt "quest"
msgid "\"Methinks thou wert unnaturally stirred by yon corpse back there, eh, varlet?\""
msgstr "« Il me semble que ce cadavre là-bas t'a drôlement émoustillé{|e}, hein, sale bug ? »"

msgctxt "quest"
msgid "\"Up thy nose with a rubber hose!\""
msgstr "« Va reformater ton cerveau ! »"

msgctxt "quest"
msgid "\"Verily, thy corpse could not smell worse!\""
msgstr "« Franchement, ton cadavre ne pourra pas sentir plus mauvais que toi ! »"

msgctxt "quest"
msgid "\"Wait!  I shall polymorph into a grid bug to give thee a fighting chance!\""
msgstr "« Attends !  Je vais me changer en bug réseau pour te laisser une chance ! »"

msgctxt "quest"
msgid "\"Why search for the Amulet?  Thou wouldst but lose it, cretin.\""
msgstr "« Pourquoi chercher l'Amulette ?  Tu la perdrais au premier piratage, crétin{|e}. »"

msgctxt "quest"
msgid "\"Thou ought to be a comedian, thy skills are so laughable!\""
msgstr "« Tu devrais faire du stand-up, tes talents sont si risibles ! »"

msgctxt "quest"
msgid "\"Thy gaze is so vacant, I thought thee a floating eye!\""
msgstr "« Ton regard est si vide que je t'ai pris{|e} pour une caméra flottante ! »"

msgctxt "quest"
msgid "\"Thy head is unfit for a mind flayer to munch upon!\""
msgstr "« Ta tête n'intéresserait même pas un pirate neuronal ! »"

msgctxt "quest"
msgid "\"Only thy reflection could love thee!\""
msgstr "« Seul ton reflet pourrait t'aimer, et encore, avec un filtre ! »"

msgctxt "quest"
msgid "\"Hast thou considered masking thine odour?\""
msgstr "« T'as déjà pensé à un déodorant ? »"

msgctxt "quest"
msgid "\"Hold! Thy face is a most exquisite torture!\""
msgstr "« Halte !  Ta tête est une torture des plus raffinées ! »"

msgctxt "quest"
msgid "\"I should fart in thy direction, but it might improve thy smell!\""
msgstr "« Je pourrais péter dans ta direction, mais ça améliorerait peut-être ton odeur ! »"

msgctxt "quest"
msgid "[%dC has chosen you to recover the Amulet of Yendor for %dI.]"
msgstr "[%dC vous a choisi{|e} pour rapporter l'Amulette de Yendor pour %dI.]"

msgctxt "quest"
msgid ""
"It is written in the Book of %d:\n"
"\n"
"    After the Creation, the cruel god Moloch rebelled\n"
"    against the authority of Marduk the Creator.\n"
"    Moloch stole from Marduk the most powerful of all\n"
"    the artifacts of the gods, the Amulet of Yendor,\n"
"    and he hid it in the dark cavities of Gehennom, the\n"
"    Under World, where he now lurks, and bides his time.\n"
"\n"
"Your %G %d seeks to possess the Amulet, and with it\n"
"to gain deserved ascendance over the other gods.\n"
"\n"
"You, a newly trained %r, have been heralded\n"
"from birth as the instrument of %d.  You are destined\n"
"to recover the Amulet for your deity, or die in the\n"
"attempt.  Your hour of destiny has come.  For the sake\n"
"of us all:  Go bravely with %d!"
msgstr ""
"Il est écrit dans le Code source de %d :\n"
"\n"
"    Après la Compilation, Moloch, le dieu cruel, se rebella\n"
"    contre l'autorité de Marduk le Programmeur.\n"
"    Moloch déroba à Marduk la plus puissante de toutes\n"
"    les clés des dieux, l'Amulette de Yendor,\n"
"    et la cacha dans les couches obscures du Réseau profond,\n"
"    là où il se tapit à présent en attendant son heure.\n"
"\n"
"Votre %G %d veut posséder l'Amulette, et obtenir grâce\n"
"à elle les droits d'administration sur tous les autres dieux.\n"
"\n"
"Vous, %r fraîchement {formé|formée}, avez été {désigné|désignée}\n"
"dès votre naissance comme l'outil de %d.  Votre mission\n"
"est de rapporter l'Amulette à votre divinité, ou de mourir\n"
"en essayant.  L'heure est venue.  Pour le salut de tous :\n"
"connectez-vous, et allez bravement avec %d !"

msgctxt "quest"
msgid ""
"It is written in the Book of %d:\n"
"\n"
"    After the Creation, the cruel god Moloch rebelled\n"
"    against the authority of Marduk the Creator.\n"
"    Moloch stole from Marduk the most powerful of all\n"
"    the artifacts of the gods, the Amulet of Yendor,\n"
"    and he hid it in the dark cavities of Gehennom, the\n"
"    Under World, where he now lurks, and bides his time.\n"
"\n"
"Your %G %d seeks to possess the Amulet, and with it\n"
"to gain deserved ascendance over the other gods.\n"
"\n"
"You, an untrained %r, have been unable to adequately\n"
"prepare to be the instrument of %d.  Nevertheless, you\n"
"are destined to recover the Amulet for your deity, or die\n"
"in the attempt.  Your hour of destiny has come.  For the\n"
"sake of us all:  Go bravely with %d!"
msgstr ""
"Il est écrit dans le Code source de %d :\n"
"\n"
"    Après la Compilation, Moloch, le dieu cruel, se rebella\n"
"    contre l'autorité de Marduk le Programmeur.\n"
"    Moloch déroba à Marduk la plus puissante de toutes\n"
"    les clés des dieux, l'Amulette de Yendor,\n"
"    et la cacha dans les couches obscures du Réseau profond,\n"
"    là où il se tapit à présent en attendant son heure.\n"
"\n"
"Votre %G %d veut posséder l'Amulette, et obtenir grâce\n"
"à elle les droits d'administration sur tous les autres dieux.\n"
"\n"
"Vous, %r sans formation ni équipement, n'avez pas pu vous\n"
"préparer à être l'outil de %d.  Pourtant, votre mission\n"
"est de rapporter l'Amulette à votre divinité, ou de mourir\n"
"en essayant.  L'heure est venue.  Pour le salut de tous :\n"
"connectez-vous, et allez bravement avec %d !"

msgctxt "quest"
msgid ""
"\"The silver bell which was hoarded by %n will be\n"
"essential in locating the Amulet of Yendor.\""
msgstr ""
"« La cloche d'argent que gardait jalousement %n sera\n"
"indispensable pour trouver l'Amulette de Yendor. »"

msgctxt "quest"
msgid ""
"You receive a faint telepathic message from %l:\n"
"Your help is urgently needed at %H!\n"
"Look for a ...ic transporter.\n"
"You couldn't quite make out that last message."
msgstr ""
"Vous recevez un message chiffré, très brouillé, @de %l :\n"
"On a besoin de vous de toute urgence @à %H !\n"
"Cherchez un transporteur ...ique.\n"
"La fin du message est perdue dans le bruit."

msgctxt "quest"
msgid "You again sense %l pleading for help."
msgstr "Un nouveau message @de %l vous supplie de venir."

msgctxt "quest"
msgid "You again sense %l demanding your attendance."
msgstr "Un nouveau message @de %l exige votre présence."

# Quête du Netrunner (Wiz)

msgctxt "quest"
msgid "the Lonely Tower"
msgstr "le data center isolé"

msgctxt "quest"
msgid "the Tower of Darkness"
msgstr "la Tour Obsidienne"

msgctxt "quest"
msgid "[Travel to %i; overcome %n; return with %o.]"
msgstr "[Rendez-vous @à %i ; vainquez %n ; revenez avec %o.]"

msgctxt "quest"
msgid ""
"\"Yes, %p, you truly are ready for this dire task.  Listen,\n"
"carefully, for what I tell you now will be of vital importance.\n"
"\n"
"\"Since you left us to hone your skills in the world, we unexpectedly came\n"
"under attack by the forces of %n.  As you know, we thought\n"
"%n had perished at the end of the last age, but, alas, this was\n"
"not the case.\n"
"\n"
"\"%nC sent an army of abominations against us.  Among them was a\n"
"minion, mindless and ensorcelled, and thus, in the confusion, it was\n"
"able to penetrate our defenses.  Alas, this creature has stolen\n"
"%o and I fear has delivered %oh to %n.\n"
"\n"
"\"Over the years, I had woven most of my power into this amulet, and thus,\n"
"without it, I have but a shadow of my former power, and I fear that I\n"
"shall soon perish.\n"
"\n"
"\"You must travel to %i, and within its dungeons,\n"
"find and overcome %n, and return %o to me.\n"
"\n"
"\"Go now, with %d, and complete this quest before it is too late.\""
msgstr ""
"« Oui, %p, vous êtes vraiment prêt{|e} pour ce contrat.  Écoutez bien,\n"
"car ce que je vais vous dire ne doit pas sortir de ce réseau.\n"
"\n"
"» Depuis que vous êtes parti{|e} faire vos armes dans la Mégalopole,\n"
"nous avons été piratés par les forces @de %n.  Nous pensions que %n\n"
"avait été effacé à la fin de la dernière guerre des réseaux, mais il\n"
"n'en était rien.\n"
"\n"
"» %nC a lâché sur nous une armée de programmes immondes.  L'un d'eux,\n"
"un simple pantin sans conscience, a franchi nos pare-feu à la faveur\n"
"du chaos.  Il a volé %o, et je crains qu'il ne l'ait remis @à %n.\n"
"\n"
"» Pendant des années, j'ai stocké l'essentiel de mon savoir dans\n"
"cette amulette ; sans elle, je ne suis plus que l'ombre de moi-même,\n"
"et mes systèmes ne tiendront plus longtemps.\n"
"\n"
"» Vous devez vous rendre @à %i, descendre dans ses sous-sols,\n"
"trouver et effacer %n, puis me rapporter %o.\n"
"\n"
"» Partez maintenant, avec %d, et remplissez ce contrat avant qu'il ne\n"
"soit trop tard. »"

msgctxt "quest"
msgid "[Go; come back when you are worthy of %d.]"
msgstr "[Partez ; revenez quand vous serez digne de %d.]"

msgctxt "quest"
msgid ""
"\"You amaze me, %p!  How many times did I tell you that the way of a mage\n"
"is an exacting one.  One must use the world with care, lest one leave it\n"
"in ruins and simplify the task of %n.\n"
"\n"
"\"You must go back and show your worthiness.  Do not return until you are\n"
"truly ready for this quest.  May %d guide you in this task.\""
msgstr ""
"« Vous me décevez, %p !  Combien de fois vous ai-je dit que le Réseau\n"
"exige de la discipline ?  On ne pirate pas le monde à tort et à travers,\n"
"sinon on le laisse en ruines et on fait le travail @de %n à sa place.\n"
"\n"
"» Repartez, et prouvez que vous en êtes digne.  Ne revenez pas avant\n"
"d'être vraiment prêt{|e} pour ce contrat.  Que %d vous guide. »"

msgctxt "quest"
msgid "[Go; return when you are %Ra.]"
msgstr "[Partez ; revenez quand vous serez %Ra.]"

msgctxt "quest"
msgid ""
"\"Alas, %p, you have not yet shown your proficiency as a worthy\n"
"spellcaster.  As %ra, you would surely be overcome in the challenge\n"
"ahead.  Go, now, expand your horizons, and return when you have attained\n"
"renown as %Ra.\""
msgstr ""
"« Désolée, %p, vous n'avez pas encore fait vos preuves dans le Réseau.\n"
"Simple %r, vous seriez grillé{|e} à la première contre-mesure.  Partez,\n"
"améliorez votre code, et revenez quand on vous connaîtra comme %Ra. »"

msgctxt "quest"
msgid "\"Your puny powers are no match for me, fool!\""
msgstr "« Ton code chétif ne fait pas le poids face au mien, imbécile ! »"

msgctxt "quest"
msgid "\"When you are defeated, your torment will last for a thousand years.\""
msgstr "« Quand tu seras vaincu{|e}, je te garderai en mémoire mille ans, pour le plaisir. »"

msgctxt "quest"
msgid "\"After your downfall, %p, I shall devour %l for dessert!\""
msgstr "« Après ta chute, %p, je formaterai %l pour le dessert ! »"

msgctxt "quest"
msgid "\"Are you ready yet to beg for mercy?  I could be lenient...\""
msgstr "« Prêt{|e} à demander grâce ?  Je pourrais être clément... ou pas. »"

msgctxt "quest"
msgid "\"Your soul shall join the enslaved multitude I command!\""
msgstr "« Ton esprit rejoindra le botnet que je commande ! »"

msgctxt "quest"
msgid "\"Your lack of will is evident, and you shall die as a result.\""
msgstr "« Ta volonté est aussi faible que ton chiffrement, et tu en mourras. »"

msgctxt "quest"
msgid "\"Your faith in %d is for naught!  Come, submit to me now!\""
msgstr "« Ta foi en %d ne sert à rien !  Viens, connecte-toi à moi ! »"

msgctxt "quest"
msgid "\"A mere %r is nothing compared to my skill!\""
msgstr "« Un{|e} simple %r face à mon talent ?  Laisse-moi rire ! »"

msgctxt "quest"
msgid "\"So, you are the best hope of %l?  How droll.\""
msgstr "« Alors c'est toi, le meilleur espoir @de %l ?  Comme c'est drôle. »"

msgctxt "quest"
msgid "\"Feel my power, %c!  My victory is imminent!\""
msgstr "« Sens ma puissance, %c !  Ma victoire est déjà compilée ! »"

msgctxt "quest"
msgid "\"Beware, for %n is immune to most magical attacks.\""
msgstr "« Attention : %n résiste à la plupart des attaques magiques. »"

msgctxt "quest"
msgid "\"To enter %i you must pass many traps.\""
msgstr "« L'accès @à %i est truffé de pièges.  Avancez lentement. »"

msgctxt "quest"
msgid "\"%nC may be vulnerable to physical attacks.\""
msgstr "« %nC est peut-être vulnérable aux bonnes vieilles attaques physiques. »"

msgctxt "quest"
msgid "\"%d will come to your aid when you call.\""
msgstr "« %d répondra si vous l'appelez. »"

msgctxt "quest"
msgid "\"You must utterly destroy %n.  He will pursue you otherwise.\""
msgstr "« Effacez complètement %n.  Sinon, il se restaurera et vous traquera. »"

msgctxt "quest"
msgid "\"%oC is a mighty artifact.  With it you can destroy %n.\""
msgstr "« %oC est une clé très puissante.  Avec elle, vous pourrez effacer %n. »"

msgctxt "quest"
msgid "\"Go forth with the blessings of %d.\""
msgstr "« Partez avec la bénédiction de %d. »"

msgctxt "quest"
msgid "\"I will have my %gP watch for your return.\""
msgstr "« Je demanderai à mes %gp de surveiller votre retour. »"

msgctxt "quest"
msgid "\"Feel free to take any items in that chest that might aid you.\""
msgstr "« Prenez dans ce coffre tout ce qui pourra vous servir. »"

msgctxt "quest"
msgid "\"You will know when %o is near.  Proceed with care!\""
msgstr "« Vous sentirez quand %o sera proche.  Avancez prudemment ! »"

msgctxt "quest"
msgid "[You have arrived at %ls tower but something is very wrong.]"
msgstr "[Vous êtes arrivé{|e} au data center @de %l, mais quelque chose cloche.]"

msgctxt "quest"
msgid ""
"You are suddenly in familiar surroundings.  You notice what appears to\n"
"be a large, squat stone structure nearby.  Wait!  That looks like the\n"
"tower of your former teacher, %l.\n"
"\n"
"However, things are not the same as when you were last here.  Mists and\n"
"areas of unexplained darkness surround the tower.  There is movement in\n"
"the shadows.\n"
"\n"
"Your teacher would never allow such unaesthetic forms to surround the\n"
"tower...  unless something were dreadfully wrong!"
msgstr ""
"Vous voilà soudain dans un décor familier.  Tout près se dresse une\n"
"grande bâtisse de béton hérissée d'antennes.  Attendez !  C'est le data\n"
"center de votre ancienne mentore, %l.\n"
"\n"
"Pourtant, rien n'est plus comme lors de votre dernière visite.  Une\n"
"brume chargée d'électricité et des zones d'ombre inexplicables entourent\n"
"le bâtiment.  Quelque chose bouge entre les serveurs.\n"
"\n"
"Votre mentore ne laisserait jamais des programmes aussi laids traîner\n"
"autour de chez elle...  à moins que quelque chose n'aille vraiment mal !"

msgctxt "quest"
msgid "You have returned to %ns lair."
msgstr "Vous êtes revenu{|e} dans l'antre @de %n."

msgctxt "quest"
msgid "You feel your mentor's presence; perhaps %o is nearby."
msgstr "Vous sentez la présence de votre mentore ; %o est peut-être tout près."

msgctxt "quest"
msgid "The aura of %o tingles at the edge of your perception."
msgstr "Le signal @de %o grésille aux limites de votre perception."

msgctxt "quest"
msgid "[You feel %os power and know you should return %oh to %l.]"
msgstr "[Vous sentez la puissance @de %o et savez que vous devez le rapporter @à %l.]"

msgctxt "quest"
msgid ""
"As you touch %o, its comforting power infuses you\n"
"with new energy.  You feel as if you can detect others' thoughts flowing\n"
"through it.  Although you yearn to wear %o and\n"
"attack the Wizard of Yendor, you know you must return it to its rightful\n"
"owner, %l."
msgstr ""
"Quand vous touchez %o, sa puissance familière vous remplit d'une\n"
"énergie nouvelle.  Vous percevez, comme un flux de données, les pensées\n"
"de tous ceux qui vous entourent.  Vous mourez d'envie de le garder pour\n"
"attaquer l'Archihacker de Yendor, mais vous savez que vous devez le\n"
"rendre à sa propriétaire légitime, %l."

msgctxt "quest"
msgid "\"I have some eye of newt to trade, do you have a spare blind-worm's sting?\""
msgstr "« J'échange des puces de rat de labo, t'aurais pas un bout de code d'orvet en trop ? »"

msgctxt "quest"
msgid "\"The magic portal now seems like it will remain stable for quite some time.\""
msgstr "« Le portail a l'air stable, maintenant.  Il devrait tenir un bon moment. »"

msgctxt "quest"
msgid "\"Have you noticed how much stronger %l is since %o was recovered?\""
msgstr "« T'as vu comme %l va mieux depuis qu'on a récupéré %o ? »"

msgctxt "quest"
msgid "\"Thank %d!  We weren't positive you would defeat %n.\""
msgstr "« Merci %d !  On n'était pas sûrs que tu effacerais %n. »"

msgctxt "quest"
msgid "\"I, too, will venture into the world, because %n was but one of many evils to be vanquished.\""
msgstr "« Moi aussi, je vais partir dans la Mégalopole : %n n'était qu'un virus parmi d'autres. »"

msgctxt "quest"
msgid "\"Would you happen to have some eye of newt in that overstuffed pack, %s?\""
msgstr "« T'aurais pas une puce de rat de labo dans ton sac trop plein, {mon frère|ma sœur} ? »"

msgctxt "quest"
msgid "\"Ah, the spell to create the magic portal worked.  Outstanding!\""
msgstr "« Ah, le script de création du portail a marché.  Remarquable ! »"

msgctxt "quest"
msgid "\"Hurry!  %lC may not survive that casting of the portal spell!\""
msgstr "« Vite !  %lC risque de ne pas survivre au lancement du portail ! »"

msgctxt "quest"
msgid "\"The spells of %n were just too powerful for us to withstand.\""
msgstr "« Les attaques @de %n étaient trop puissantes pour nos pare-feu. »"

msgctxt "quest"
msgid "\"I, too, will venture into the world, because %n is but one of many evils to be vanquished.\""
msgstr "« Moi aussi, je vais partir dans la Mégalopole : %n n'est qu'un virus parmi d'autres. »"

msgctxt "quest"
msgid "[Take the Amulet to %ds altar on the Astral Plane.]"
msgstr "[Portez l'Amulette à l'autel de %d dans le Plan astral.]"

msgctxt "quest"
msgid ""
"\"Congratulations, %p.  I always knew that if anyone could succeed\n"
"in defeating the Wizard of Yendor and his minions, it would be you.\n"
"\n"
"\"Go now, and take the Amulet to the Astral Plane.  Once there, present\n"
"the Amulet on the altar of %d.  Along the way you shall pass through\n"
"the four Elemental Planes.  These planes are like nothing you have ever\n"
"experienced before, so be prepared!\n"
"\n"
"\"For this you were born, %s!  I am very proud of you.\""
msgstr ""
"« Félicitations, %p.  J'ai toujours su que si quelqu'un pouvait vaincre\n"
"l'Archihacker de Yendor et ses sbires, ce serait vous.\n"
"\n"
"» Partez maintenant, et portez l'Amulette jusqu'au Plan astral.  Là-bas,\n"
"présentez-la sur l'autel de %d.  En chemin, vous traverserez les quatre\n"
"Couches du Réseau.  Elles ne ressemblent à rien de ce que vous avez\n"
"connu, alors soyez prêt{|e} !\n"
"\n"
"» Vous êtes né{|e} pour ça, {mon frère|ma sœur} !  Je suis très fière\n"
"de vous. »"

msgctxt "quest"
msgid "[%nC curses you as %nh dies.]"
msgstr "[%nC vous maudit en mourant.]"

msgctxt "quest"
msgid ""
"%nC, whose body begins to shrivel up, croaks out:\n"
"\n"
"    \"I shall haunt your progress until the end of time.  A thousand\n"
"    curses on you and %l.\"\n"
"\n"
"Then, the body bursts into a cloud of choking dust, and blows away."
msgstr ""
"%nC, dont l'image se pixellise déjà, grésille :\n"
"\n"
"    « Je hanterai tes réseaux jusqu'à la fin des temps.  Mille\n"
"    virus sur toi et sur %l. »\n"
"\n"
"Puis son corps se défait en un nuage de pixels morts, qui s'éteint."

msgctxt "quest"
msgid "[You have come a long way, but are you ready for the task I require?]"
msgstr "[Vous avez fait beaucoup de chemin, mais êtes-vous prêt{|e} pour le contrat que je vous réserve ?]"

msgctxt "quest"
msgid ""
"\"Come closer, %p, for my voice falters in my old age.\n"
"Yes, I see that you have come a long way since you went out into the\n"
"world, leaving the safe confines of this tower.  However, I must first\n"
"determine if you have all of the skills required to take on the task\n"
"I require of you.\""
msgstr ""
"« Approchez, %p, ma voix passe mal, ces temps-ci.\n"
"Oui, je vois que vous avez fait beaucoup de chemin depuis que vous avez\n"
"quitté l'abri de ce data center.  Mais je dois d'abord vérifier que\n"
"vous avez tout ce qu'il faut pour le contrat que je vous réserve. »"

msgctxt "quest"
msgid "[\"Get out of here!\"]"
msgstr "[« Sortez d'ici ! »]"

msgctxt "quest"
msgid ""
"\"You fool, %p!  Why did I waste all of those years teaching you\n"
"the esoteric arts?  Get out of here!  I shall find another.\""
msgstr ""
"« Imbécile, %p !  Pourquoi ai-je perdu des années à vous apprendre\n"
"le code ?  Sortez d'ici !  J'en trouverai {un autre|une autre}. »"

msgctxt "quest"
msgid "\"Well, %p, you have returned.  Perhaps you are now ready...\""
msgstr "« Eh bien, %p, vous revoilà.  Peut-être êtes-vous prêt{|e}, cette fois... »"

msgctxt "quest"
msgid ""
"\"This is getting tedious, %p, but perseverance is a sign of a true mage.\n"
"I certainly hope that you are truly ready this time!\""
msgstr ""
"« Ça devient lassant, %p, mais l'obstination fait les bons netrunners.\n"
"J'espère que cette fois, vous êtes vraiment prêt{|e} ! »"

msgctxt "quest"
msgid "Wisps of fog swirl nearby.  You feel that %ns lair is close."
msgstr ""
"Des volutes de brouillard électrique tourbillonnent tout près.  Vous\n"
"sentez que l'antre @de %n est proche."

msgctxt "quest"
msgid "You believe that you may once again invade %i."
msgstr "Vous pensez pouvoir de nouveau pénétrer dans %i."

msgctxt "quest"
msgid "[\"Your destruction should make for good sport.\"]"
msgstr "[« Ta destruction devrait être un bon divertissement. »]"

msgctxt "quest"
msgid ""
"\"Ah, I recognize you, %p.  So, %l has sent you to steal\n"
"%o from me, hmmm?  Well, %lh is a fool to send such\n"
"a mental weakling against me.\n"
"\n"
"\"Your destruction, however, should make for good sport.  In the end, you\n"
"shall beg me to kill you!\""
msgstr ""
"« Ah, je te reconnais, %p.  Alors %l t'a envoyé{|e} me voler\n"
"%o, hmmm ?  Il faut que %lh soit folle pour m'envoyer\n"
"{un tel script-kiddie|une telle script-kiddie}.\n"
"\n"
"» Ta destruction, en revanche, devrait être un bon divertissement.  À la\n"
"fin, tu me supplieras de te déconnecter ! »"

msgctxt "quest"
msgid "[\"Your soul shall soon be mine to command.\"]"
msgstr "[« Ton esprit sera bientôt à mes ordres. »]"

msgctxt "quest"
msgid ""
"\"How nice of you to return, %p!  I enjoyed our last meeting.  Are you\n"
"still hungry for more pain?\n"
"\n"
"\"Come!  Your soul, like %o, shall soon be mine to command.\""
msgstr ""
"« Comme c'est gentil de revenir, %p !  J'ai adoré notre dernière\n"
"rencontre.  Tu en redemandes ?\n"
"\n"
"» Viens !  Ton esprit, comme %o, sera bientôt à mes ordres. »"

msgctxt "quest"
msgid ""
"\"I'm sure that your perseverance shall be the subject of innumerable\n"
"ballads, but you shall not be around to hear them, I fear!\""
msgstr ""
"« Ton obstination inspirera sans doute bien des chansons sur le Réseau,\n"
"mais tu ne seras plus là pour les entendre ! »"

msgctxt "quest"
msgid ""
"\"Thief!  %oC belongs to me, now.  I shall feed\n"
"your living flesh to my minions.\""
msgstr ""
"« {Voleur|Voleuse} !  %oC m'appartient, désormais.  Je donnerai\n"
"ton cerveau en pâture à mes programmes. »"

msgctxt "quest"
msgid "Once again, you are back at %H."
msgstr "Vous voici de nouveau @à %H."

msgctxt "quest"
msgid "[Take %o with you in your quest for the Amulet.]"
msgstr "[Emportez %o dans votre quête de l'Amulette.]"

msgctxt "quest"
msgid ""
"%lC notices %o in your possession,\n"
"beams at you and says:\n"
"\n"
"    \"I knew you could defeat %n and retrieve\n"
"    %o.  We shall never forget this\n"
"    brave service.\n"
"\n"
"    \"Take %oh with you in your quest for the Amulet of Yendor.\n"
"    I can sense that it has attuned %oiself to you already.\n"
"\n"
"    \"May %d guide you in your quest, and keep you from harm.\""
msgstr ""
"%lC remarque %o en votre possession,\n"
"vous adresse un large sourire et dit :\n"
"\n"
"    « Je savais que vous pourriez effacer %n et reprendre\n"
"    %o.  Nous n'oublierons jamais ce\n"
"    que vous avez fait.\n"
"\n"
"    » Emportez-le dans votre quête de l'Amulette de Yendor.\n"
"    Je sens qu'il s'est déjà synchronisé avec vous.\n"
"\n"
"    » Que %d vous guide dans votre quête, et vous protège. »"

msgctxt "quest"
msgid "[Keep %o, return through the portal to %Z; find the other Amulet.]"
msgstr "[Gardez %o, repassez le portail vers %Z ; trouvez l'autre Amulette.]"

msgctxt "quest"
msgid ""
"\"You are the keeper of %o now.  It is time to\n"
"recover the /other/ Amulet.  %Z await your return through\n"
"the magic portal which brought you here.\""
msgstr ""
"« Vous êtes désormais {le gardien|la gardienne} @de %o.  Il est temps de\n"
"reprendre l'/autre/ Amulette.  %ZC vous attend de l'autre côté du\n"
"portail qui vous a amené{|e} ici. »"

msgctxt "quest"
msgid ""
"You are back at %H.\n"
"You have an odd feeling this may be the last time you ever come here."
msgstr ""
"Vous voici de retour @à %H.\n"
"Vous avez l'étrange impression que c'est peut-être la dernière fois que\n"
"vous venez ici."

msgctxt "quest"
msgid ""
"\"Come near, my %S, and share your adventures with me.\n"
"So, have you succeeded in your quest for the Amulet of Yendor?\""
msgstr ""
"« Approchez, {mon fils|ma fille}, et racontez-moi vos aventures.\n"
"Alors, avez-vous réussi votre quête de l'Amulette de Yendor ? »"

# Quête du Récupérateur (Arc)

msgctxt "quest"
msgid "the College of Archeology"
msgstr "le Campus d'archéotechnique"

msgctxt "quest"
msgid "the Tomb of the Toltec Kings"
msgstr "le Bunker des rois toltèques"

msgctxt "quest"
msgid ""
"\"Grave times have befallen the college, for %na has\n"
"stolen %o.  Without it, the board of directors of\n"
"the university will soon have no choice but to revoke our research grants.\n"
"\n"
"\"You must locate the entrance to %i.  Within it,\n"
"you will find %n.\n"
"\n"
"\"You must then defeat %n and return %o\n"
"to me.\n"
"\n"
"\"Only in this way will we be able to prevent the budget cuts that could\n"
"close this college.\n"
"\n"
"\"May the wisdom of %d be your guide.\""
msgstr ""
"« Les temps sont durs pour le campus : %na nous a\n"
"volé %o.  Sans lui, nos actionnaires vont couper\n"
"les crédits de la fondation, et tous nos chantiers de fouille\n"
"fermeront.\n"
"\n"
"» Vous devez trouver l'entrée @de %i.  Tout au fond,\n"
"vous trouverez %n.\n"
"\n"
"» Il vous faudra effacer %n et me rapporter\n"
"%o.\n"
"\n"
"» C'est notre seule chance d'échapper au plan social qui menace\n"
"ce campus.\n"
"\n"
"» Que les algorithmes de %d vous guident. »"

msgctxt "quest"
msgid "[\"%pC, you have strayed from the %a path.  Purify yourself!\"]"
msgstr "[« %pC, vous vous êtes écarté{|e} de la voie %af.  Faites le ménage ! »]"

msgctxt "quest"
msgid ""
"\"%pC!  I've heard that you've been using sloppy techniques.  Your\n"
"results lately can hardly be called suitable for %ra!\n"
"\n"
"\"How could you have strayed from the %a path?  Go from here, and come\n"
"back only when you have purified yourself.\""
msgstr ""
"« %pC !  On me dit que vous fouillez comme un pilleur de décharge.\n"
"Vos derniers rapports sont indignes @de %ra !\n"
"\n"
"» Comment avez-vous pu quitter la voie %af ?  Sortez d'ici, et\n"
"ne revenez qu'une fois votre dossier blanchi. »"

msgctxt "quest"
msgid "[%pC, a mere %r is too inexperienced.]"
msgstr "[%pC, un{|e} simple %r n'a pas assez de terrain.]"

msgctxt "quest"
msgid ""
"\"%p, you are yet too inexperienced to undertake such a demanding\n"
"quest.  A mere %r could not possibly face the rigors demanded and\n"
"survive.  Go forth, and come here again when your adventures have further\n"
"taught you.\""
msgstr ""
"« %p, vous n'avez pas encore assez d'heures de terrain pour un contrat\n"
"pareil.  Un{|e} simple %r ne reviendrait pas vivant{|e} des\n"
"profondeurs qui l'attendent.  Repartez fouiller les ruines, et revenez\n"
"quand vous aurez plus d'expérience. »"

msgctxt "quest"
msgid "\"Try your best, %p.  You cannot defeat me.\""
msgstr "« Fais de ton mieux, %p.  Tu ne peux pas me battre. »"

msgctxt "quest"
msgid "\"I shall rend the flesh from your body whilst you still breathe!\""
msgstr "« Je t'arracherai tes implants un par un, vivant{|e} ! »"

msgctxt "quest"
msgid "\"First you, %p, then I shall destroy your mentor, %l.\""
msgstr "« Toi d'abord, %p, puis j'effacerai ton mentor, %l. »"

msgctxt "quest"
msgid "\"Tiring yet, %p?  I draw my power from my master and cannot falter!\""
msgstr ""
"« Déjà à court de batterie, %p ?  Mon maître m'alimente, et je ne\n"
"faiblirai pas ! »"

msgctxt "quest"
msgid "\"I shall rend thy soul from thy body and consume it!\""
msgstr "« J'extrairai ton âme de ta carcasse et je la compresserai ! »"

msgctxt "quest"
msgid "\"You are far too %a -- it weakens you.  You shall die in this place.\""
msgstr "« Tu es bien trop {%a|%af} -- c'est ta faille.  Tu crèveras ici. »"

msgctxt "quest"
msgid "\"%d has forsaken you!  You are lost now!\""
msgstr "« %d t'a déconnecté{|e} !  Tu es fichu{|e} maintenant ! »"

msgctxt "quest"
msgid "\"A mere %r cannot hope to defeat me!\""
msgstr "« Un{|e} simple %r ne peut pas espérer me vaincre ! »"

msgctxt "quest"
msgid "\"If you are the best %l can send, I have nothing to fear.\""
msgstr "« Si tu es ce que %l a de mieux en magasin, je n'ai rien à craindre. »"

msgctxt "quest"
msgid "\"Die %c!  I shall exhibit your carcass as a trophy.\""
msgstr "« Crève, %c !  J'exposerai ta carcasse dans une vitrine. »"

msgctxt "quest"
msgid "\"Beware, for %n is powerful and cunning.\""
msgstr "« Méfiez-vous : %n est puissant et retors. »"

msgctxt "quest"
msgid "\"To locate the entrance to %i, you must pass many traps.\""
msgstr "« Le chemin de l'entrée @de %i est truffé de pièges. »"

msgctxt "quest"
msgid "\"A %nt may be vulnerable to attacks by magical cold.\""
msgstr "« Un %nt craint peut-être les attaques cryogéniques. »"

msgctxt "quest"
msgid "\"Call upon %d when you encounter %n.\""
msgstr "« Appelez %d quand vous affronterez %n. »"

msgctxt "quest"
msgid "\"You must destroy %n.  It will pursue you otherwise.\""
msgstr "« Vous devez effacer %n.  Sinon, il vous traquera sans fin. »"

msgctxt "quest"
msgid "\"%oC is a mighty talisman.  With it you can destroy %n.\""
msgstr "« %oC est un artefact puissant.  Avec lui, vous pourrez détruire %n. »"

msgctxt "quest"
msgid "\"Remember not to stray from the true %a path.\""
msgstr "« Ne vous écartez pas de la vraie voie %af. »"

msgctxt "quest"
msgid "\"You may be able to sense %o when you are near.\""
msgstr "« Vous pourrez peut-être capter le signal @de %o quand vous en serez proche. »"

msgctxt "quest"
msgid ""
"You are suddenly in familiar surroundings.  The buildings in the distance\n"
"seem to be those of your old alma mater, but something is wrong.  It feels\n"
"as if there has been a riot recently, or %H has\n"
"been under siege.\n"
"\n"
"All of the windows are boarded up, and there are objects scattered around\n"
"the entrance.\n"
"\n"
"Strange forbidding shapes seem to be moving in the distance."
msgstr ""
"Vous voilà soudain dans un décor familier.  Les tours au loin\n"
"ressemblent à celles de votre ancien campus, mais quelque chose cloche.\n"
"On dirait qu'il y a eu une émeute récemment, ou que %H a été\n"
"assiégé.\n"
"\n"
"Les fenêtres sont murées de tôle, et des carcasses de drones traînent\n"
"devant l'entrée.\n"
"\n"
"D'étranges silhouettes menaçantes semblent bouger au loin."

msgctxt "quest"
msgid "[This strange feeling must be the presence of %o.]"
msgstr "[Ce signal étrange doit venir @de %o.]"

msgctxt "quest"
msgid ""
"A strange feeling washes over you, and you think back to things you\n"
"learned during the many lectures of %l.\n"
"\n"
"You realize the feeling must be the presence of %o."
msgstr ""
"Un signal étrange fait grésiller vos capteurs, et vous repensez aux\n"
"nombreux séminaires @de %l.\n"
"\n"
"Vous comprenez que ce signal doit venir @de %o."

msgctxt "quest"
msgid "The familiar presence of %o is in the ether."
msgstr "Le signal familier @de %o grésille dans l'éther."

msgctxt "quest"
msgid "[The power of %o flows through your body!  You must return it to %l.]"
msgstr "[La puissance @de %o parcourt vos circuits !  Vous devez le rapporter à %l.]"

msgctxt "quest"
msgid ""
"The power of %o flows through your body!  You feel\n"
"as if you could now take on the Wizard of Yendor himself and win, but\n"
"you know you must return %o to %l."
msgstr ""
"La puissance @de %o parcourt vos circuits !  Vous vous sentez\n"
"capable d'affronter l'Archihacker de Yendor en personne et de le vaincre,\n"
"mais vous savez que vous devez rapporter %o à %l."

msgctxt "quest"
msgid "\"Did you see Lash LaRue in 'Song of Old Wyoming' the other night?\""
msgstr "« T'as vu le vieux western restauré en 16K sur le réseau l'autre soir ? »"

msgctxt "quest"
msgid "\"I guess you are guaranteed to make full professor now.\""
msgstr "« Avec ça, tu vas sûrement décrocher ta titularisation. »"

msgctxt "quest"
msgid "\"So, what was worse, %n or your entrance exams?\""
msgstr "« Alors, c'était quoi le pire, %n ou ton concours d'entrée ? »"

msgctxt "quest"
msgid "\"%oC is impressive, but nothing like the bones I dug up!\""
msgstr "« %oC est impressionnant, mais rien à voir avec le serveur que j'ai déterré ! »"

msgctxt "quest"
msgid "\"Did you see the artifact %l brought back from the last dig?\""
msgstr "« T'as vu la relique que %l a rapportée de la dernière fouille ? »"

msgctxt "quest"
msgid "\"So what species do *you* think we evolved from?\""
msgstr "« À ton avis, on descend de quel modèle, *toi* ? »"

msgctxt "quest"
msgid "\"So you're %ls prize pupil!  I don't know what he sees in you.\""
msgstr "« Alors c'est toi {le chouchou|la chouchoute} @de %l !  Je me demande bien ce qu'il te trouve. »"

msgctxt "quest"
msgid ""
"\"Congratulations, %p.  I wondered if anyone could prevail against\n"
"the Wizard and the minions of Moloch.  Now, you must embark on one\n"
"final adventure.\n"
"\n"
"\"Take the Amulet, and find your way onto the Astral Plane.\n"
"There you must find the altar of %d and sacrifice the\n"
"Amulet on that altar to fulfill your destiny.\n"
"\n"
"\"Remember, your path now should always be upwards.\""
msgstr ""
"« Félicitations, %p.  Je me demandais si quelqu'un viendrait à bout\n"
"de l'Archihacker et des sbires de Moloch.  Il vous reste maintenant une\n"
"toute dernière fouille.\n"
"\n"
"» Prenez l'Amulette et trouvez le chemin du Plan astral.\n"
"Là, vous devrez trouver l'autel de %d et y sacrifier\n"
"l'Amulette pour accomplir votre destin.\n"
"\n"
"» Souvenez-vous : votre chemin doit désormais toujours monter. »"

msgctxt "quest"
msgid "The body of %n dissipates in a cloud of noxious fumes."
msgstr "Le corps @de %n se dissout dans un nuage de fumée toxique."

msgctxt "quest"
msgid "[\"You have returned, %p, to a difficult task.\"]"
msgstr "[« Vous êtes revenu{|e}, %p, pour un contrat difficile. »]"

msgctxt "quest"
msgid ""
"\"Finally you have returned, %p.  You were always\n"
"my most promising student.  Allow me to see if you are ready for the\n"
"most difficult task of your career.\""
msgstr ""
"« Vous voilà enfin de retour, %p.  Vous avez toujours été\n"
"{mon stagiaire le plus prometteur|ma stagiaire la plus prometteuse}.  Voyons si vous êtes prêt{|e}\n"
"pour le chantier le plus difficile de votre carrière. »"

msgctxt "quest"
msgid ""
"\"%p, you have failed us.  All of my careful training has been in\n"
"vain.  Begone!  Your tenure at this college has been revoked!\n"
"\n"
"\"You are a disgrace to the profession!\""
msgstr ""
"« %p, vous nous avez déçus.  Toutes ces années de formation pour\n"
"rien.  Partez !  Votre badge du campus est désactivé !\n"
"\n"
"» Vous êtes la honte de la profession ! »"

msgctxt "quest"
msgid ""
"\"Again, %p, you stand before me.\n"
"Let me see if you have gained experience in the interim.\""
msgstr ""
"« Vous voici de nouveau devant moi, %p.\n"
"Voyons si vos fouilles vous ont appris quelque chose entre-temps. »"

msgctxt "quest"
msgid ""
"\"Once more, %p, you have returned from the field.\n"
"Are you finally ready for the task that must be accomplished?\""
msgstr ""
"« Vous revoilà de retour du terrain, %p.\n"
"Êtes-vous enfin prêt{|e} pour le travail qui nous attend ? »"

msgctxt "quest"
msgid "[This foreboding edifice must hide the entrance to %i.]"
msgstr "[Ce bâtiment menaçant doit cacher l'entrée @de %i.]"

msgctxt "quest"
msgid ""
"A plain opens before you.  Beyond the plain lies a foreboding edifice.\n"
"\n"
"You have the feeling that you will soon find the entrance to\n"
"%i."
msgstr ""
"Une friche industrielle s'étend devant vous.  Au-delà se dresse un\n"
"bâtiment de béton menaçant.\n"
"\n"
"Vous sentez que vous trouverez bientôt l'entrée @de %i."

msgctxt "quest"
msgid ""
"\"So, %p, you think that you can succeed in recovering\n"
"%o, when your teacher, %l, has already failed.\n"
"\n"
"\"Come, try your best!  I shall destroy you, and gnaw on your bones.\""
msgstr ""
"« Ainsi, %p, tu crois pouvoir reprendre %o,\n"
"alors que ton maître, %l, a déjà échoué.\n"
"\n"
"» Viens, fais de ton mieux !  Je vais te détruire et recycler tes os. »"

msgctxt "quest"
msgid ""
"\"Again you try to best me, eh %p?  Well, you shall fail again.\n"
"\n"
"\"You shall never recover %o.\n"
"\n"
"\"I shall bear your soul to the Plane of Origins for my master's pleasure.\""
msgstr ""
"« Tu essaies encore de me battre, hein, %p ?  Eh bien, tu échoueras\n"
"encore.\n"
"\n"
"» Tu ne reprendras jamais %o.\n"
"\n"
"» J'emporterai ton âme jusqu'à la Couche d'origine pour amuser mon\n"
"maître. »"

msgctxt "quest"
msgid "\"You persist yet %p!  Good.  Now, you shall die!\""
msgstr "« Tu t'obstines encore, %p !  Parfait.  Maintenant, tu vas mourir ! »"

msgctxt "quest"
msgid ""
"%lC touches %o briefly, gazes into it,\n"
"then smiles at you and says:\n"
"\n"
"\"Well done, %p.  You have defeated %n and\n"
"recovered %o.  But I fear that it shall never be safe\n"
"here.\n"
"\n"
"Please take %o with you.  You, %p, can\n"
"guard it now far better than I.\n"
"\n"
"May the blessings of %d follow you and guard you.\""
msgstr ""
"%lC passe brièvement %o au scanner, étudie les relevés,\n"
"puis vous sourit et dit :\n"
"\n"
"« Beau travail, %p.  Vous avez vaincu %n et\n"
"repris %o.  Mais je crains qu'il ne soit jamais en\n"
"sécurité ici : nos actionnaires voudraient le revendre.\n"
"\n"
"» Je vous en prie, emportez %o avec vous.  Vous, %p, saurez\n"
"le garder bien mieux que moi désormais.\n"
"\n"
"» Que les bénédictions de %d vous accompagnent et vous protègent. »"

msgctxt "quest"
msgid "[\"Resume your search for the Amulet beyond the magic portal to %Z.\"]"
msgstr "[« Reprenez votre recherche de l'Amulette au-delà du portail vers %Z. »]"

msgctxt "quest"
msgid ""
"\"Careful, %p!  %oC might break, and that would be\n"
"a tragic loss.  You are its keeper now, and the time has come to\n"
"resume your search for the Amulet.  %Z await your\n"
"return through the magic portal that brought you here.\""
msgstr ""
"« Attention, %p !  %oC est fragile, et ce serait\n"
"une perte tragique.  Vous en êtes désormais {le gardien|la gardienne}, et le\n"
"moment est venu de reprendre votre recherche de l'Amulette.  %ZC attendent\n"
"votre retour par le portail qui vous a amené{|e} ici. »"

# Quête du Cogneur (Bar)

msgctxt "quest"
msgid "the Camp of the Duali Tribe"
msgstr "le Squat de la tribu Duali"

msgctxt "quest"
msgid "the Duali Oasis"
msgstr "la Station de pompage des Duali"

msgctxt "quest"
msgid "[\"Find %n, defeat %ni, and return %o to us.\"]"
msgstr "[« Trouvez %n, effacez-le et rapportez-nous %o. »]"

msgctxt "quest"
msgid ""
"\"The world is in great need of your assistance, %p.\n"
"\n"
"\"About six months ago, I learned that a mysterious sorcerer, known\n"
"as %n, had begun to gather a large group of cutthroats and brigands\n"
"about %ni.\n"
"\n"
"\"At about the same time, these people you once rode with `liberated' a\n"
"potent magical talisman, %o, from a Turanian caravan.\n"
"\n"
"\"%nC and %nj Black Horde swept down upon %i and defeated\n"
"the people there, driving them out into the desert.  He has taken\n"
"%o, and seeks to bend it to %nj will.  I detected the\n"
"subtle changes in the currents of fate, and joined these people.\n"
"Then I sent forth a summons for you.\n"
"\n"
"\"If %n can bend %o to %nj will, he will become\n"
"almost indestructible.  He will then be able to enslave the minds of\n"
"men across the world.  You are the only hope.  The gods smile upon you,\n"
"and with %d behind you, you alone can defeat %n.\n"
"\n"
"\"You must go to %i.  From there, you can track down\n"
"%n, defeat %ni, and return %o to us.  Only\n"
"then will the world be safe.\""
msgstr ""
"« La rue a grand besoin de vos poings, %p.\n"
"\n"
"» Il y a environ six mois, j'ai appris qu'un mystérieux techno-sorcier,\n"
"connu sous le nom de %n, rassemblait autour de lui une grosse\n"
"bande de coupe-jarrets et de pilleurs.\n"
"\n"
"» À peu près au même moment, votre ancien gang, celui avec qui vous\n"
"rouliez, a « libéré » un puissant artefact, %o, d'un convoi blindé\n"
"touranien.\n"
"\n"
"» %nC et sa Horde noire ont déferlé sur %i et écrasé\n"
"ceux qui s'y trouvaient, les chassant dans les friches.  Il a pris\n"
"%o et cherche à le pirater pour le plier à sa volonté.  J'ai capté\n"
"les variations subtiles dans les flux du destin, et j'ai rejoint ces\n"
"gens.  Puis je vous ai fait chercher.\n"
"\n"
"» Si %n parvient à plier %o à sa volonté, il deviendra\n"
"presque indestructible.  Il pourra alors asservir l'esprit de tous les\n"
"humains connectés.  Vous êtes notre seul espoir.  Les dieux vous sourient,\n"
"et avec %d à vos côtés, vous seul{|e} pouvez vaincre %n.\n"
"\n"
"» Vous devez vous rendre @à %i.  De là, vous pourrez traquer\n"
"%n, le défoncer et nous rapporter %o.  Alors\n"
"seulement la rue sera en sécurité. »"

msgctxt "quest"
msgid ""
"\"%pC!  You have wandered from the path of the %a!\n"
"If you attempt to overcome %n in this state, he will surely\n"
"enslave your soul.  Your only hope, and ours, lies in your purification.\n"
"Go forth, and return when you feel ready.\""
msgstr ""
"« %pC !  Vous vous êtes écarté{|e} de la voie %af !\n"
"Si vous affrontez %n dans cet état, il piratera sûrement\n"
"votre âme.  Votre seul espoir, et le nôtre, c'est de vous remettre\n"
"dans le droit chemin.  Partez, et revenez quand vous serez prêt{|e}. »"

msgctxt "quest"
msgid ""
"\"%p, I fear that you are as yet too inexperienced to face\n"
"%n.  Only %Ra with the help of %d could ever hope to\n"
"defeat %ni.\""
msgstr ""
"« %p, je crains que vous n'ayez pas encore assez de bagarres dans les\n"
"jambes pour affronter %n.  Seul{|e} %Ra avec l'aide de %d pourrait\n"
"espérer le vaincre. »"

msgctxt "quest"
msgid "\"My pets will dine on your carcass tonight!\""
msgstr "« Mes chiens-robots dîneront de ta carcasse ce soir ! »"

msgctxt "quest"
msgid "\"You are a sorry excuse for %ra.\""
msgstr "« Tu n'es qu'une contrefaçon @de %ra. »"

msgctxt "quest"
msgid "\"%d cannot protect you now.  Here, you die.\""
msgstr "« %d ne peut plus te protéger.  Ici, tu crèves. »"

msgctxt "quest"
msgid "\"Come, %c.  I shall kill you, then unleash the horde on your tribe.\""
msgstr "« Viens, %c.  Je vais te tuer, puis lâcher la horde sur ton gang. »"

msgctxt "quest"
msgid "\"Once you are dead, my horde shall finish off %l, and your tribe.\""
msgstr "« Une fois que tu seras mort{|e}, ma horde achèvera %l, et ton gang. »"

msgctxt "quest"
msgid "\"You have failed, %c.  Now, my victory is complete.\""
msgstr "« Tu as échoué, %c.  Maintenant, ma victoire est totale. »"

msgctxt "quest"
msgid "\"%nC is strong in the dark arts, but not immune to cold steel.\""
msgstr "« %nC maîtrise le code noir, mais il ne résiste pas à une bonne barre à mine. »"

msgctxt "quest"
msgid "\"Remember that %n is a great sorcerer.  He lived in the time of Atlantis.\""
msgstr "« Souvenez-vous que %n est un grand techno-sorcier.  Il a survécu au Grand Krach. »"

msgctxt "quest"
msgid "\"To enter %i, you must be very stealthy.  The horde will be on guard.\""
msgstr "« Pour entrer @à %i, vous devrez être très {discret|discrète}.  La horde a des guetteurs partout. »"

msgctxt "quest"
msgid "\"Call upon %d in your time of need.\""
msgstr "« Appelez %d en cas de besoin. »"

msgctxt "quest"
msgid "\"If you can lay hands upon %o, carry it for good fortune.\""
msgstr "« Si vous mettez la main sur %o, gardez-le sur vous, il porte chance. »"

msgctxt "quest"
msgid "\"I cannot stand against %ns sorcery.  But %d will help you.\""
msgstr "« Je ne peux pas résister aux sortilèges @de %n.  Mais %d vous aidera. »"

msgctxt "quest"
msgid "\"Do not fear %n.  I know you can defeat %ni.\""
msgstr "« N'ayez pas peur de %n.  Je sais que vous pouvez le défoncer. »"

msgctxt "quest"
msgid "[You reach the vicinity of %H, but sense evil magic nearby.]"
msgstr "[Vous approchez @de %H, mais vous sentez du code maléfique tout proche.]"

msgctxt "quest"
msgid ""
"Warily you scan your surroundings, all of your senses alert for signs\n"
"of possible danger.  Off in the distance, you can %x the familiar shapes\n"
"of %H.\n"
"\n"
"But why, you think, should %l be there?\n"
"\n"
"Suddenly, the hairs on your neck stand on end as you detect the aura of\n"
"evil magic in the air.\n"
"\n"
"Without thought, you ready your weapon, and mutter under your breath:\n"
"\n"
"    \"By %d, there will be blood spilt today.\""
msgstr ""
"Prudemment, vous scrutez les environs, tous vos sens à l'affût du\n"
"moindre signe de danger.  Au loin, vous parvenez à %x les silhouettes\n"
"familières @de %H.\n"
"\n"
"Mais pourquoi, vous demandez-vous, %l serait-il là ?\n"
"\n"
"Soudain, les poils de votre nuque se hérissent : vos implants captent\n"
"les parasites d'un code maléfique dans l'air.\n"
"\n"
"Sans réfléchir, vous apprêtez votre arme et grognez entre vos dents :\n"
"\n"
"    « Par %d, le sang coulera aujourd'hui. »"

msgctxt "quest"
msgid ""
"The hairs on the nape of your neck lift as you sense an energy in the\n"
"very air around you.  You fight down a primordial panic that seeks to\n"
"make you turn and run.  This is surely the lair of %n."
msgstr ""
"Les poils de votre nuque se dressent : l'air même qui vous entoure\n"
"grésille d'énergie.  Vous réprimez une panique primitive qui vous\n"
"pousse à faire demi-tour et à fuir.  C'est sûrement l'antre @de %n."

msgctxt "quest"
msgid "Yet again you feel the air around you heavy with malevolent magical energy."
msgstr "Une fois de plus, l'air autour de vous grésille d'une énergie malveillante."

msgctxt "quest"
msgid "[You feel the power of %o flowing through your hands.]"
msgstr "[Vous sentez la puissance @de %o couler dans vos mains.]"

msgctxt "quest"
msgid ""
"As you pick up %o, you feel the power of it\n"
"flowing through your hands.  It seems to be in two or more places\n"
"at once, even though you are holding it."
msgstr ""
"Quand vous ramassez %o, vous sentez sa puissance\n"
"couler dans vos mains.  Il semble exister en deux endroits ou plus\n"
"à la fois, alors même que vous le tenez."

msgctxt "quest"
msgid "\"The battles here have been good -- our enemies' blood soaks the soil!\""
msgstr "« Les bastons ont été bonnes ici -- le sang de nos ennemis imbibe le bitume ! »"

msgctxt "quest"
msgid "\"Remember that glory is crushing your enemies beneath your feet!\""
msgstr "« N'oublie pas que la gloire, c'est d'écraser tes ennemis sous tes rangers ! »"

msgctxt "quest"
msgid "\"Times will be good again, now that the horde is vanquished.\""
msgstr "« Les temps seront de nouveau bons, maintenant que la horde est écrasée. »"

msgctxt "quest"
msgid "\"You have brought our clan much honor in defeating %n.\""
msgstr "« Tu as couvert notre gang d'honneur en battant %n. »"

msgctxt "quest"
msgid "\"There has been little treasure to loot, since the horde arrived.\""
msgstr "« Il n'y a plus grand-chose à piller depuis que la horde est arrivée. »"

msgctxt "quest"
msgid "\"The horde is mighty in numbers, but they have little courage.\""
msgstr "« La horde est nombreuse, mais elle n'a pas de tripes. »"

msgctxt "quest"
msgid "\"%lC is a strange one, but he has helped defend us.\""
msgstr "« %lC est un drôle de bonhomme, mais il nous a aidés à tenir le quartier. »"

msgctxt "quest"
msgid ""
"\"This is wondrous, %p.  I feared that you could not possibly\n"
"succeed in your quest, but here you are in possession of the Amulet\n"
"of Yendor!\n"
"\n"
"\"I have studied the texts of the magi constantly since you left.  In\n"
"the Book of Skelos, I found this:\n"
"\n"
"    %d will cause a child to be sent into the world.  This child is to\n"
"    be made strong by trial of battle and magic, for %d has willed it so.\n"
"    It is said that the child of %d will recover the Amulet of Yendor\n"
"    that was stolen from the Creator at the beginning of time.\n"
"\n"
"\"As you now possess the amulet, %p, I suspect that the Book\n"
"speaks of you.\n"
"\n"
"    The child of %d will take the Amulet, and travel to the Astral\n"
"    Plane, where the Great Temple of %d is to be found.  The Amulet\n"
"    will be sacrificed to %d, there on %dJ altar.  Then the child will\n"
"    stand by %d as champion of all %cP for eternity.\n"
"\n"
"\"This is all I know, %p.  I hope it will help you.\""
msgstr ""
"« C'est prodigieux, %p.  Je craignais que vous ne puissiez réussir\n"
"votre quête, mais vous voici en possession de l'Amulette de Yendor !\n"
"\n"
"» J'ai décrypté sans relâche les archives des hackers depuis votre\n"
"départ.  Dans le Codex de Skelos, j'ai trouvé ceci :\n"
"\n"
"    %d fera envoyer un enfant dans le monde.  Cet enfant sera\n"
"    endurci par l'épreuve du combat et du code, car %d l'a voulu.\n"
"    Il est dit que l'enfant de %d reprendra l'Amulette de Yendor\n"
"    qui fut dérobée au Créateur au commencement des temps.\n"
"\n"
"» Puisque vous possédez maintenant l'Amulette, %p, je soupçonne que\n"
"le Codex parle de vous.\n"
"\n"
"    L'enfant de %d prendra l'Amulette et voyagera jusqu'au Plan\n"
"    astral, où se trouve le Grand Temple de %d.  L'Amulette\n"
"    sera sacrifiée à %d, là, sur son autel.  Alors l'enfant se\n"
"    tiendra aux côtés de %d, champion de tous les %cp pour l'éternité.\n"
"\n"
"» C'est tout ce que je sais, %p.  J'espère que cela vous aidera. »"

msgctxt "quest"
msgid "[%nC curses you, but you feel the overpowering aura of magic fading.]"
msgstr "[%nC vous maudit, mais vous sentez l'écrasante aura de code s'estomper.]"

msgctxt "quest"
msgid ""
"%nC falls to the ground, and utters a last curse at you.  Then %nj\n"
"body fades slowly, seemingly dispersing into the air around you.  You\n"
"slowly become aware that the overpowering aura of magic in the air has\n"
"begun to fade."
msgstr ""
"%nC s'effondre et vous lance une dernière malédiction.  Puis son corps\n"
"se pixellise lentement et semble se disperser dans l'air autour de vous.\n"
"Vous prenez peu à peu conscience que l'écrasante aura de code qui\n"
"saturait l'air commence à s'estomper."

msgctxt "quest"
msgid "[\"At last you have returned.  There is a great quest you must undertake.\"]"
msgstr "[« Enfin vous êtes revenu{|e}.  Il y a un gros coup que vous devez faire. »]"

msgctxt "quest"
msgid ""
"\"Ah, %p.  You have returned at last.  The world is in dire\n"
"need of your help.  There is a great quest you must undertake.\n"
"\n"
"\"But first, I must see if you are ready to take on such a challenge.\""
msgstr ""
"« Ah, %p.  Vous voilà enfin de retour.  La rue a cruellement\n"
"besoin de vous.  Il y a un gros coup que vous devez faire.\n"
"\n"
"» Mais d'abord, je dois voir si vous êtes prêt{|e} à relever un tel défi. »"

msgctxt "quest"
msgid ""
"\"Pah!  You have betrayed the gods, %p.  You will never attain\n"
"the glory which you aspire to.  Your failure to follow the true path has\n"
"closed this future to you.\n"
"\n"
"\"I will protect these people as best I can, but soon %n will overcome\n"
"me and destroy all who once called you %s.  Now begone!\""
msgstr ""
"« Peuh !  Vous avez trahi les dieux, %p.  Jamais vous n'atteindrez\n"
"la gloire à laquelle vous aspirez.  En ne suivant pas la vraie voie,\n"
"vous vous êtes fermé cet avenir.\n"
"\n"
"» Je protégerai ces gens du mieux que je pourrai, mais bientôt %n\n"
"me vaincra et détruira tous ceux qui vous appelaient autrefois %s.\n"
"Maintenant, dégagez ! »"

msgctxt "quest"
msgid ""
"The scent of water comes to you in the desert breeze.  You know that\n"
"you have located %i."
msgstr ""
"Le vent des friches vous apporte une odeur d'eau.  Vous savez que\n"
"vous avez trouvé %i."

msgctxt "quest"
msgid ""
"\"So.  This is what that second rate sorcerer %l sends to do %lj bidding.\n"
"I have slain many before you.  You shall give me little sport.\n"
"\n"
"\"Prepare to die, %c.\""
msgstr ""
"« Ainsi, voilà ce que ce bidouilleur de seconde zone, %l, envoie faire\n"
"ses commissions.  J'en ai tué beaucoup avant toi.  Tu ne m'amuseras\n"
"guère.\n"
"\n"
"» Prépare-toi à mourir, %c. »"

msgctxt "quest"
msgid "\"I have wasted too much time on you already.  Now, you shall die.\""
msgstr "« J'ai déjà perdu trop de cycles avec toi.  Maintenant, tu vas mourir. »"

msgctxt "quest"
msgid ""
"\"I shall have %o back, you pitiful excuse for %ca.\n"
"And your life as well.\""
msgstr ""
"« Je reprendrai %o, pitoyable contrefaçon @de %ca.\n"
"Et ta vie avec. »"

msgctxt "quest"
msgid ""
"When %l sees %o, he smiles, and says:\n"
"\n"
"    Well done, %p.  You have saved the world from certain doom.\n"
"    What, now, should be done with %o?\n"
"\n"
"    These people, brave as they are, cannot hope to guard it from\n"
"    other sorcerers who will detect it, as surely as %n did.\n"
"\n"
"    Take %o with you, %p.  It will guard you in\n"
"    your adventures, and you can best guard it.  You embark on a\n"
"    quest far greater than you realize.\n"
"\n"
"    Remember me, %p, and return when you have triumphed.  I\n"
"    will tell you then of what you must do.  You will understand when the\n"
"    time comes."
msgstr ""
"Quand %l voit %o, il sourit et dit :\n"
"\n"
"    Bien joué, %p.  Vous avez sauvé la rue d'une perte certaine.\n"
"    Que faut-il faire maintenant @de %o ?\n"
"\n"
"    Ces gens, si braves soient-ils, ne peuvent espérer le protéger\n"
"    des autres techno-sorciers qui le repéreront, aussi sûrement que\n"
"    %n l'a fait.\n"
"\n"
"    Emportez %o, %p.  Il vous protégera dans\n"
"    vos virées, et c'est vous qui le protégerez le mieux.  Vous vous\n"
"    lancez dans un coup bien plus gros que vous ne le pensez.\n"
"\n"
"    Souvenez-vous de moi, %p, et revenez quand vous aurez triomphé.\n"
"    Je vous dirai alors ce que vous devez faire.  Vous comprendrez le\n"
"    moment venu."

msgctxt "quest"
msgid ""
"%l gazes reverently at %o, then back at you.\n"
"\n"
"\"You are its keeper now, and the time has come to resume your search\n"
"for the Amulet.  %Z await your return through the\n"
"magic portal which brought you here.\""
msgstr ""
"%lC contemple %o avec respect, puis vous regarde.\n"
"\n"
"« Vous en êtes désormais {le gardien|la gardienne}, et le moment est venu\n"
"de reprendre votre recherche de l'Amulette.  %ZC attendent votre retour\n"
"par le portail qui vous a amené{|e} ici. »"

msgctxt "quest"
msgid "\"Tell us, %p, have you fared well on your great quest?\""
msgstr "« Dites-nous, %p, votre gros coup se passe bien ? »"

# Quête du Sauvageon (Cav)

msgctxt "quest"
msgid "the Caves of the Ancestors"
msgstr "les Tunnels des Ancêtres"

msgctxt "quest"
msgid "the Dragon's Lair"
msgstr "le Collecteur du Dragon"

msgctxt "quest"
msgid ""
"\"You are indeed ready now, %p.  I shall tell you a tale of\n"
"great suffering among your people:\n"
"\n"
"\"Shortly after you left on your vision quest, the caves were invaded by\n"
"the creatures sent against us by %n.\n"
"\n"
"\"She, herself, could not attack us due to her great size, but her minions\n"
"have harassed us ever since.  In the first attacks, many died, and the\n"
"minions of %n managed to steal %o.\n"
"They took it to %i and there, none of our\n"
"%g warriors have been able to go.\n"
"\n"
"\"You must find %i, and within it wrest\n"
"%o from %n.  She guards it as\n"
"jealously as she guards all treasures she attains.  But with it,\n"
"we can make our caves safe once more.\n"
"\n"
"\"Please, %p, recover %o for us, and return it here.\""
msgstr ""
"« Vous êtes vraiment prêt{|e} maintenant, %p.  Je vais vous conter\n"
"les malheurs de votre tribu :\n"
"\n"
"» Peu après votre départ pour votre quête de vision, les tunnels ont été\n"
"envahis par les créatures que %n a lâchées sur nous.\n"
"\n"
"» Elle-même est trop grosse pour passer dans nos galeries, mais\n"
"ses sbires nous harcèlent depuis.  Lors des premiers raids, beaucoup\n"
"sont morts, et les sbires @de %n ont réussi à voler %o.\n"
"Ils l'ont emporté @à %i, et aucun de nos\n"
"chasseurs n'a pu s'y rendre.\n"
"\n"
"» Vous devez trouver %i, et là, arracher\n"
"%o @à %n.  Elle le garde aussi\n"
"jalousement que toute la ferraille qu'elle amasse.  Mais avec lui,\n"
"nous pourrons de nouveau vivre en paix dans nos tunnels.\n"
"\n"
"» Je vous en prie, %p, reprenez %o pour nous et rapportez-le ici. »"

msgctxt "quest"
msgid ""
"\"%pC!  You have deviated from my teachings.  You no longer follow\n"
"the path of the %a as you should.  I banish you from these caves, to\n"
"go forth and purify yourself.  Then, you might be able to accomplish this\n"
"quest.\""
msgstr ""
"« %pC !  Vous vous êtes écarté{|e} de mes enseignements.  Vous ne suivez\n"
"plus la voie %af comme vous le devriez.  Je vous bannis de ces tunnels :\n"
"partez et purifiez-vous.  Alors, vous pourrez peut-être accomplir cette\n"
"quête. »"

msgctxt "quest"
msgid ""
"\"Alas, %p, you are as yet too inexperienced to embark upon such\n"
"a difficult quest as that I propose to give you.\n"
"\n"
"\"%rA could not possibly survive the rigors demanded to find\n"
"%i, never mind to confront %n herself.\n"
"\n"
"\"Adventure some more, and you will learn the skills you will require.\n"
"%d decrees it.\""
msgstr ""
"« Hélas, %p, vous manquez encore trop d'expérience pour vous lancer\n"
"dans une quête aussi dure que celle que je veux vous confier.\n"
"\n"
"» %rA ne survivrait pas aux dangers qu'il faut braver pour trouver\n"
"%i, sans même parler d'affronter %n en personne.\n"
"\n"
"» Retournez traîner dans les friches, et vous apprendrez ce qu'il vous\n"
"faut savoir.  %d l'ordonne. »"

msgctxt "quest"
msgid "\"You shall die here, %c.  %rA cannot hope to defeat me.\""
msgstr "« Tu crèveras ici, %c.  %rA ne peut espérer me vaincre. »"

msgctxt "quest"
msgid "\"My claws are sharp now.  I shall rip you to shreds!\""
msgstr "« Mes griffes sont affûtées comme des lames de cutter.  Je vais te mettre en pièces ! »"

msgctxt "quest"
msgid "\"%d has deserted you, %c.  This is my domain.\""
msgstr "« %d t'a abandonné{|e}, %c.  Ici, c'est mon territoire. »"

msgctxt "quest"
msgid "\"%nC is immune to her own breath weapons. You should use magic upon her that she does not use herself.\""
msgstr "« %nC ne craint pas ses propres souffles.  Utilisez contre elle une arme qu'elle n'emploie pas elle-même. »"

msgctxt "quest"
msgid "\"When you encounter %n, call upon %d for assistance.\""
msgstr "« Quand vous affronterez %n, appelez %d à l'aide. »"

msgctxt "quest"
msgid "\"There will be nowhere to hide inside %ns inner sanctum.\""
msgstr "« Il n'y aura nulle part où se cacher dans le repaire @de %n. »"

msgctxt "quest"
msgid "\"Do not be distracted by the great treasures in %ns lair. Concentrate on %o.\""
msgstr "« Ne vous laissez pas distraire par le butin entassé dans l'antre @de %n.  Concentrez-vous sur %o. »"

msgctxt "quest"
msgid "\"%oC is the only object that %n truly fears.\""
msgstr "« %oC est la seule chose que %n craigne vraiment. »"

msgctxt "quest"
msgid "\"Do not be fooled by %ns size.  She is fast, and it is rumored that she uses magic.\""
msgstr "« Ne vous fiez pas à la taille @de %n.  Elle est rapide, et on dit qu'elle connaît des sortilèges. »"

msgctxt "quest"
msgid "\"I would send a party of %gP with you, but we will need all of our strength to defend ourselves.\""
msgstr "« Je vous ferais bien accompagner par une bande de %gp, mais nous aurons besoin de tous nos bras pour tenir les tunnels. »"

msgctxt "quest"
msgid ""
"You descend through a barely familiar stairwell that you remember\n"
"%l showing you when you embarked upon your vision quest.\n"
"\n"
"You arrive back at %H, but something seems\n"
"wrong here.  The usual smoke and glowing light of the fires of the\n"
"outer caves are absent, and an uneasy quiet fills the damp air."
msgstr ""
"Vous descendez un escalator en panne à peine familier, celui que\n"
"%l vous avait montré quand vous êtes parti{|e} pour votre quête de vision.\n"
"\n"
"Vous voilà de retour dans %H, mais quelque chose\n"
"cloche.  La fumée habituelle et la lueur des braseros dans les vieilles\n"
"rames de métro ont disparu, et un silence inquiétant emplit l'air humide."

msgctxt "quest"
msgid "[You enter a large cavern.  %nC is present.]"
msgstr "[Vous entrez dans une immense salle souterraine.  %nC est là.]"

msgctxt "quest"
msgid ""
"You find yourself in a large cavern, with neatly polished walls, that\n"
"nevertheless show signs of being scorched by fire.\n"
"\n"
"Bones litter the floor, and there are objects scattered everywhere.\n"
"The air is close with the stench of sulphurous fumes.\n"
"\n"
"%nC is clearly visible, but %nh seems to be asleep."
msgstr ""
"Vous vous trouvez dans une immense salle souterraine aux parois de béton\n"
"lisses, noircies pourtant par des traces de brûlure.\n"
"\n"
"Des ossements jonchent le sol, au milieu de carcasses de machines.\n"
"L'air empeste les vapeurs de soufre et l'huile brûlée.\n"
"\n"
"%nC est bien visible, mais %nh semble dormir."

msgctxt "quest"
msgid "\"The rains have returned and the land grows lush again.\""
msgstr "« Les pluies acides se sont calmées, et la mousse repousse dans les tunnels. »"

msgctxt "quest"
msgid "\"So, %p, tell us the story of your fight with %n.\""
msgstr "« Alors, %p, raconte-nous ta baston contre %n. »"

msgctxt "quest"
msgid "\"We have not been able to gather as much food since the Giants sealed off our access to the outer world.\""
msgstr "« On ne trouve plus grand-chose à manger depuis que les Géants nous ont coupé la sortie vers la surface. »"

msgctxt "quest"
msgid "\"Since %n sent her minions, we have been constantly fighting.\""
msgstr "« Depuis que %n a envoyé ses sbires, on ne cesse de se battre. »"

msgctxt "quest"
msgid "\"I have heard your vision quest was successful.  Is this so?\""
msgstr "« Paraît que ta quête de vision a réussi.  C'est vrai ? »"

msgctxt "quest"
msgid "\"%lC grows old.  We know not who will guide us after he ascends.\""
msgstr "« %lC se fait vieux.  On ne sait pas qui nous guidera après son ascension. »"

msgctxt "quest"
msgid ""
"\"You have been successful, I see, %p.\n"
"\n"
"\"Now that the Amulet of Yendor is yours, here is what you must do:\n"
"\n"
"\"Journey upwards to the open air.  The Amulet you carry will then\n"
"take you into the Astral Planes, where the Great Temple of %d\n"
"casts its influence throughout our world.\n"
"\n"
"\"Sacrifice the Amulet on the altar.  Thus shall %d become supreme!\""
msgstr ""
"« Vous avez réussi, je le vois, %p.\n"
"\n"
"» Maintenant que l'Amulette de Yendor est à vous, voici ce que vous devez\n"
"faire :\n"
"\n"
"» Remontez jusqu'à la surface.  L'Amulette que vous portez vous emmènera\n"
"alors dans les Plans astraux, d'où le Grand Temple de %d\n"
"étend son influence sur toute la Mégalopole.\n"
"\n"
"» Sacrifiez l'Amulette sur l'autel.  Ainsi %d deviendra suprême ! »"

msgctxt "quest"
msgid ""
"%nC sinks to the ground, her heads flailing about.\n"
"As she dies, a cloud of noxious fumes billows about her."
msgstr ""
"%nC s'effondre, ses têtes s'agitant en tous sens.\n"
"Tandis qu'elle meurt, un nuage de fumée toxique s'élève autour d'elle."

msgctxt "quest"
msgid ""
"\"%pC!  You have sealed our fate.  You seem unable to reform yourself,\n"
"so I must select another to take your place.\n"
"\n"
"\"Begone from %H!  You have betrayed us by choosing\n"
"the path of the %C over the true path of the %L.\n"
"\n"
"\"You no longer live in our eyes.\""
msgstr ""
"« %pC !  Vous avez scellé notre sort.  Vous semblez incapable de vous\n"
"amender, je dois donc choisir quelqu'un d'autre pour vous remplacer.\n"
"\n"
"» Quittez %H !  Vous nous avez trahis en choisissant\n"
"la voie chaotique plutôt que la vraie voie loyale.\n"
"\n"
"» Pour la tribu, vous n'existez plus. »"

msgctxt "quest"
msgid ""
"You %x many large claw marks on the ground.  The tunnels ahead\n"
"of you are larger than most of those in any cave complex you have\n"
"ever been in before.\n"
"\n"
"Your nose detects the smell of carrion from within, and bones litter\n"
"the sides of the tunnels."
msgstr ""
"Vous parvenez à %x de nombreuses traces de grandes griffes dans la boue.\n"
"Les conduites devant vous sont plus larges que presque tous les égouts\n"
"où vous êtes jamais allé{|e}.\n"
"\n"
"Votre nez détecte une odeur de charogne venant de l'intérieur, et des\n"
"ossements s'entassent contre les grilles."

msgctxt "quest"
msgid ""
"%lC glimpses %o in your possession.\n"
"He smiles and says:\n"
"\n"
"    You have done it!  We are saved.  But I fear that %o\n"
"    will always be a target for %C forces who will want it for their\n"
"    own.\n"
"\n"
"    To prevent further trouble, I would like you, %p,\n"
"    to take %o away with you.  It will help you as you\n"
"    quest for the Amulet of Yendor."
msgstr ""
"%lC aperçoit %o en votre possession.\n"
"Il sourit et dit :\n"
"\n"
"    Vous avez réussi !  Nous sommes sauvés.  Mais je crains que %o\n"
"    ne soit toujours une cible pour les gangs chaotiques qui voudront\n"
"    se l'approprier.\n"
"\n"
"    Pour éviter d'autres ennuis, j'aimerais que vous, %p,\n"
"    emportiez %o avec vous.  Il vous aidera dans\n"
"    votre quête de l'Amulette de Yendor."

msgctxt "quest"
msgid ""
"%l grasps %o proudly for a moment, then looks at you.\n"
"\n"
"\"You are its keeper now, and the time has come to resume your search\n"
"for the Amulet.  %Z await your return through the\n"
"magic portal which brought you here.\""
msgstr ""
"%lC serre fièrement %o un instant, puis vous regarde.\n"
"\n"
"« Vous en êtes désormais {le gardien|la gardienne}, et le moment est venu\n"
"de reprendre votre recherche de l'Amulette.  %ZC attendent votre retour\n"
"par le portail qui vous a amené{|e} ici. »"

# Quête du Charcudoc (Hea)

msgctxt "quest"
msgid "the Temple of Epidaurus"
msgstr "la Clinique d'Épidaure"

msgctxt "quest"
msgid "the Temple of Coeus"
msgstr "le Laboratoire de Coéos"

msgctxt "quest"
msgid ""
"For the first time, you sense a smile on %ls face.\n"
"\n"
"    \"You have indeed learned as much as we can teach you in preparation\n"
"    for this task.  Let me tell you what I know of the symptoms and hope\n"
"    that you can provide a cure.\n"
"\n"
"    \"A short while ago, the dreaded %nt was fooled by the gods\n"
"    into thinking that %nh could use %o to find a\n"
"    cure for old age.  Think of it, eternal youth!  But %nj good\n"
"    health is accomplished by drawing the health from those around %ni.\n"
"\n"
"    \"He has exhausted %nj own supply of healthy people and now %nh seeks to\n"
"    extend %nj influence into our world.  You must recover from %ni\n"
"    %o and break the spell.\n"
"\n"
"    \"You must travel into the swamps to %i, and from there\n"
"    follow the trail to %ns island lair.  Be careful.\""
msgstr ""
"Pour la première fois, vous devinez un sourire sur le visage d'%l.\n"
"\n"
"    « Vous avez vraiment appris tout ce que nous pouvions vous enseigner\n"
"    pour vous préparer à cette tâche.  Laissez-moi vous exposer les\n"
"    symptômes, et espérons que vous saurez trouver le traitement.\n"
"\n"
"    » Il y a peu, le redoutable %nt a été dupé par les dieux :\n"
"    il a cru pouvoir se servir @de %o pour mettre au point\n"
"    un traitement contre la vieillesse.  Imaginez, la jeunesse éternelle !\n"
"    Mais sa santé, il l'obtient en pompant celle de ceux qui l'entourent.\n"
"\n"
"    » Il a épuisé son propre stock de cobayes, et maintenant il veut\n"
"    contaminer toute la Mégalopole.  Vous devez lui reprendre %o et\n"
"    neutraliser le virus.\n"
"\n"
"    » Vous devez traverser les marais toxiques jusqu'@à %i, et de là\n"
"    suivre la piste jusqu'à l'île où %n a son antre.  Soyez prudent{|e}. »"

msgctxt "quest"
msgid ""
"\"You have learned much of the remedies that benefit, but you must also\n"
"know which physic for which ail.  That is why %ds teachings are a\n"
"part of your training.\n"
"\n"
"\"Return to us when you have healed thyself.\""
msgstr ""
"« Vous en savez long sur les traitements, mais vous devez aussi savoir\n"
"quel remède convient à quel patient.  C'est pourquoi le code éthique\n"
"de %d fait partie de votre formation.\n"
"\n"
"» Revenez parmi nous quand vous vous serez soigné{|e} vous-même. »"

msgctxt "quest"
msgid ""
"\"Alas, %p, you are yet too inexperienced to deal with the rigors\n"
"of such a task.  You must be able to draw on the knowledge of botany,\n"
"alchemy and veterinary practices before I can send you on this quest \n"
"with good conscience.\n"
"\n"
"\"Return when you wear %Ra's caduceus.\""
msgstr ""
"« Hélas, %p, vous manquez encore trop d'expérience pour affronter les\n"
"rigueurs d'une telle tâche.  Vous devez maîtriser la pharmacologie,\n"
"la chimie de synthèse et la chirurgie des implants avant que je puisse\n"
"en conscience vous envoyer en mission.\n"
"\n"
"» Revenez quand vous porterez la blouse @de %Ra. »"

msgctxt "quest"
msgid "\"They might as well give scalpels to wizards as to let you try to use %o!\""
msgstr "« Autant confier un scalpel laser à un netrunner que de te laisser te servir @de %o ! »"

msgctxt "quest"
msgid "\"You will have to kill me if you ever hope to leave this place.\""
msgstr "« Il te faudra me tuer si tu espères jamais sortir d'ici. »"

msgctxt "quest"
msgid "\"There is no materia medica in your sack which will cure you of me!\""
msgstr "« Aucune drogue de ta trousse ne te guérira de moi ! »"

msgctxt "quest"
msgid "\"Do not fight too hard, I want your soul strong, not weakened!\""
msgstr "« Ne te bats pas trop fort, je veux ton âme en pleine forme, pas affaiblie ! »"

msgctxt "quest"
msgid "\"You should have stopped studying at veterinary.\""
msgstr "« Tu aurais dû t'arrêter à la clinique vétérinaire. »"

msgctxt "quest"
msgid "\"Remember, %p, to always wash your hands before operating.\""
msgstr "« Souvenez-vous, %p, de toujours stériliser vos instruments avant d'opérer. »"

msgctxt "quest"
msgid "\"%nC has no real magic of %nj own.  To this %nh is vulnerable.\""
msgstr "« %nC n'a pas de vrai code à lui.  C'est par là qu'il est vulnérable. »"

msgctxt "quest"
msgid "\"If you have been true to %d, you can draw on the power of %o.\""
msgstr "« Si vous êtes resté{|e} fidèle à %d, vous pourrez puiser dans la puissance @de %o. »"

msgctxt "quest"
msgid "\"Bring with you antidotes for poisons.\""
msgstr "« Emportez des antidotes contre les toxines. »"

msgctxt "quest"
msgid "\"Remember this, %n can twist the powers of %o to hurt instead of heal.\""
msgstr "« Souvenez-vous : %n peut détourner la puissance @de %o pour blesser au lieu de soigner. »"

msgctxt "quest"
msgid "\"Maybe when you return the snakes will once again begin to shed.\""
msgstr "« Peut-être qu'à votre retour, les rats de labo recommenceront à se reproduire. »"

msgctxt "quest"
msgid "\"The plague grows worse as we speak.  Hurry, %p!\""
msgstr "« L'épidémie s'aggrave à l'heure où nous parlons.  Hâtez-vous, %p ! »"

msgctxt "quest"
msgid "\"Many times %n has caused trouble in these lands.  It is time that %nh was eradicated like the diseases %nh has caused.\""
msgstr "« Bien des fois %n a semé le trouble dans ces quartiers.  Il est temps de l'éradiquer comme les virus qu'il a lâchés. »"

msgctxt "quest"
msgid ""
"What sorcery has brought you back to %H?  The smell\n"
"of fresh funeral pyres tells you that something is amiss with the healing\n"
"powers that used to practice here.\n"
"\n"
"No rhizotomists are tending the materia medica gardens, and where are the\n"
"common folk who used to come for the cures?\n"
"\n"
"You know that you must quickly make your way to the collegium, and\n"
"%ls iatreion, and find out what has happened in your absence."
msgstr ""
"Quel bug vous a ramené{|e} @à %H ?  L'odeur des incinérateurs qui\n"
"tournent à plein régime vous apprend que quelque chose ne va pas chez\n"
"les charcudocs qui exerçaient ici.\n"
"\n"
"Personne ne s'occupe des cuves de culture, et où sont passés les\n"
"pauvres gens qui venaient se faire soigner à crédit ?\n"
"\n"
"Vous savez que vous devez gagner au plus vite la clinique, et\n"
"le bloc opératoire d'%l, pour découvrir ce qui s'est passé en votre absence."

msgctxt "quest"
msgid ""
"You stand within sight of the infamous Isle of %n.  Even\n"
"the words of %l had not prepared you for this.\n"
"\n"
"Steeling yourself against the wails of the ill that pierce your ears,\n"
"you hurry on your task.  Maybe with %o you can\n"
"heal them on your return, but not now."
msgstr ""
"Vous voici en vue de la sinistre Île @de %n.  Même\n"
"les paroles d'%l ne vous avaient pas préparé{|e} à cela.\n"
"\n"
"Vous blindant contre les gémissements des malades qui vous percent les\n"
"oreilles, vous vous hâtez d'accomplir votre tâche.  Peut-être pourrez-vous\n"
"les soigner avec %o à votre retour, mais pas maintenant."

msgctxt "quest"
msgid "[You feel the healing power of %o and should return it to %l.]"
msgstr "[Vous sentez la puissance curative @de %o ; vous devriez le rapporter à %l.]"

msgctxt "quest"
msgid ""
"As you pick up %o, you feel its healing begin to\n"
"warm your soul.  You curse Zeus for taking it from its rightful owner,\n"
"but at least you hope that %l can put it to good use once\n"
"again."
msgstr ""
"Quand vous ramassez %o, vous sentez sa puissance curative\n"
"réchauffer peu à peu votre âme.  Vous maudissez Zeus de l'avoir pris à\n"
"son propriétaire légitime, mais vous espérez au moins que %l pourra de\n"
"nouveau en faire bon usage."

msgctxt "quest"
msgid "\"Did you read that new treatise on the therapeutic use of leeches?\""
msgstr "« Tu as lu cette nouvelle étude sur l'usage thérapeutique des nanobots-sangsues ? »"

msgctxt "quest"
msgid "\"Paint a red caduceus on your shield and monsters won't hit you.\""
msgstr "« Peins une croix rouge sur ton bouclier et les gangs ne te toucheront pas. »"

msgctxt "quest"
msgid "\"How are you feeling?  Perhaps a good bleeding will improve your spirits.\""
msgstr "« Comment te sens-tu ?  Une bonne vidange de fluides te remonterait peut-être le moral. »"

msgctxt "quest"
msgid "\"Have you heard the absurd new theory that diseases are caused by microscopic organisms, and not ill humors?\""
msgstr "« Tu as entendu cette théorie absurde selon laquelle les maladies seraient causées par des virus informatiques, et non par de mauvais implants ? »"

msgctxt "quest"
msgid "\"I see that you bring %o, now you can cure this plague!\""
msgstr "« Je vois que tu rapportes %o, maintenant tu peux soigner cette épidémie ! »"

msgctxt "quest"
msgid "\"I passed handwriting so they are demoting me a rank.\""
msgstr "« J'ai réussi l'examen de certification, alors ils m'ont rétrogradé d'un échelon. »"

msgctxt "quest"
msgid "\"I've heard that even %l has not been able to cure Chiron.\""
msgstr "« Paraît que même %l n'a pas pu soigner Chiron. »"

msgctxt "quest"
msgid "\"We think %n has used %nj alchemists, and %o, to unleash a new disease we call 'the cold' on Gehennom.\""
msgstr "« Nous pensons que %n s'est servi de ses chimistes et @de %o pour répandre dans le Réseau profond une nouvelle maladie que nous appelons « le rhume ». »"

msgctxt "quest"
msgid ""
"\"Ah, you have recovered the Amulet, %p.  Well done!\n"
"\n"
"\"Now, you should know that you must travel through the Elemental Planes\n"
"to the Astral, and there return the Amulet to %d.  Go forth and\n"
"may our prayers be as a wind upon your back.\""
msgstr ""
"« Ah, vous avez repris l'Amulette, %p.  Bien joué !\n"
"\n"
"» Maintenant, sachez que vous devez traverser les Couches du Réseau\n"
"jusqu'au Plan astral, et là rendre l'Amulette à %d.  Partez, et\n"
"que nos prières soient comme un vent qui vous pousse. »"

msgctxt "quest"
msgid ""
"The battered body of %n slumps to the ground and gasps\n"
"out one last curse:\n"
"\n"
"    \"You have defeated me, %p, but I shall have my revenge.\n"
"    How, I shall not say, but this curse shall be like a cancer\n"
"    on you.\"\n"
"\n"
"With that %n dies."
msgstr ""
"Le corps meurtri @de %n s'effondre et, dans un dernier souffle,\n"
"lance une ultime malédiction :\n"
"\n"
"    « Tu m'as vaincu, %p, mais j'aurai ma vengeance.\n"
"    Comment, je ne le dirai pas, mais cette malédiction te rongera\n"
"    comme un virus. »\n"
"\n"
"Sur ces mots, %n meurt."

msgctxt "quest"
msgid ""
"Feebly, %l raises %lj head to look at you.\n"
"\n"
"\"It is good to see you again, %p.  I see the concern in your\n"
"eyes, but do not worry for me.  I am not ready for Hades yet.  We have\n"
"exhausted much of our healing powers holding off %n.\n"
"I need your fresh strength to carry on our work.\n"
"\n"
"\"Come closer and let me lay hands on you, and determine if you have\n"
"the skills necessary to accomplish this mission.\""
msgstr ""
"Faiblement, %l lève la tête pour vous regarder.\n"
"\n"
"« Je suis heureux de vous revoir, %p.  Je vois l'inquiétude dans vos\n"
"yeux, mais ne vous en faites pas pour moi.  Je ne suis pas encore prêt\n"
"pour Hadès.  Nous avons épuisé presque tous nos stocks de médicaments\n"
"à repousser %n.  J'ai besoin de vos forces neuves pour\n"
"poursuivre notre œuvre.\n"
"\n"
"» Approchez, que je vous passe au scanner pour voir si vous avez\n"
"les compétences nécessaires pour accomplir cette mission. »"

msgctxt "quest"
msgid "[You are a failure as a healer.]"
msgstr "[Vous avez échoué en tant que charcudoc.]"

msgctxt "quest"
msgid ""
"\"You have failed us, %p.  You are a quack!  A charlatan!\n"
"\n"
"\"Hades will be happy to hear that you are once again practicing your\n"
"arts on the unsuspecting.\""
msgstr ""
"« Vous nous avez déçus, %p.  Vous êtes {un charlatan|une charlatane} !\n"
"{Un boucher|Une bouchère} !\n"
"\n"
"» Hadès sera ravi d'apprendre que vous opérez de nouveau\n"
"les imprudents. »"

msgctxt "quest"
msgid ""
"\"Again you return to me, %p.  I sense that each trip back\n"
"the pleurisy and maladies of our land begin to infect you.  Let us\n"
"hope and pray to %d that you become ready for your task before\n"
"you fall victim to the bad humors.\""
msgstr ""
"« Vous revenez encore à moi, %p.  Je sens qu'à chacun de vos retours,\n"
"les virus et les maux de notre quartier commencent à vous infecter.\n"
"Espérons et prions %d que vous soyez prêt{|e} pour votre tâche avant\n"
"de tomber malade à votre tour. »"

msgctxt "quest"
msgid ""
"You stand before the entrance to %i.  Strange\n"
"scratching noises come from within the building.\n"
"\n"
"The swampy ground around you seems to stink with disease."
msgstr ""
"Vous vous tenez devant l'entrée @de %i.  D'étranges\n"
"grattements proviennent de l'intérieur du bâtiment.\n"
"\n"
"Les eaux stagnantes autour de vous semblent empester les produits\n"
"chimiques et la maladie."

msgctxt "quest"
msgid "\"Which would you like, %p?  Boils, pleurisy, convulsions?\""
msgstr "« Que préfères-tu, %p ?  Une nécrose, un rejet de greffe, des convulsions ? »"

msgctxt "quest"
msgid ""
"\"I'll have %o back from you, %r.  You are\n"
"not going to live to escape this place.\""
msgstr ""
"« Je te reprendrai %o, %r.  Tu ne sortiras\n"
"pas vivant{|e} d'ici. »"

msgctxt "quest"
msgid ""
"After your last experience you expected to be here, but you certainly\n"
"did not expect to see things so much worse.  This time you must succeed."
msgstr ""
"Après votre dernière visite, vous vous attendiez à être ici, mais\n"
"certainement pas à trouver les choses tellement pires.  Cette fois, vous\n"
"devez réussir."

msgctxt "quest"
msgid ""
"As soon as %l sees %o %lh summons %lj\n"
"%gP.\n"
"\n"
"Gently, %l reaches out and touches %o.\n"
"He instructs each of the assembled to do the same.  When everyone\n"
"has finished %lh speaks to you.\n"
"\n"
"    \"Now that we have been replenished we can defeat this plague.  You must\n"
"    take %o with you and replenish the worlds you have\n"
"    been called upon to travel next.  I wish you could ride Chiron to the\n"
"    end of your journey, but I need him to help me spread the cure.  Go\n"
"    now and continue your journey.\""
msgstr ""
"Dès que %l voit %o, %lh fait venir ses\n"
"%gp.\n"
"\n"
"Doucement, %l tend la main et touche %o.\n"
"Il demande à chacun des présents d'en faire autant.  Quand tous ont\n"
"fini, %lh s'adresse à vous.\n"
"\n"
"    « Maintenant que nous avons repris des forces, nous pouvons vaincre\n"
"    cette épidémie.  Vous devez emporter %o pour redonner des forces aux\n"
"    mondes que vous êtes appelé{|e} à parcourir ensuite.  J'aimerais que\n"
"    vous puissiez chevaucher Chiron jusqu'au bout de votre voyage, mais\n"
"    j'ai besoin de lui pour m'aider à distribuer le vaccin.  Partez\n"
"    maintenant, et poursuivez votre voyage. »"

msgctxt "quest"
msgid ""
"%l cautiously handles %o while watching you.\n"
"\n"
"\"You are its keeper now, and the time has come to resume your search\n"
"for the Amulet.  %Z await your return through the\n"
"magic portal which brought you here.\""
msgstr ""
"%lC manipule %o avec précaution tout en vous observant.\n"
"\n"
"« Vous en êtes désormais {le gardien|la gardienne}, et le moment est venu\n"
"de reprendre votre recherche de l'Amulette.  %ZC attendent votre retour\n"
"par le portail qui vous a amené{|e} ici. »"

msgctxt "quest"
msgid ""
"Again, you %x %H in the distance.\n"
"\n"
"The smell of death and disease permeates the air.  You do not have\n"
"to be %Ra to know that %n is on the verge of victory."
msgstr ""
"Une fois de plus, vous parvenez à %x %H au loin.\n"
"\n"
"Une odeur de mort et de désinfectant imprègne l'air.  Pas besoin d'être\n"
"%Ra pour savoir que %n est sur le point de l'emporter."

