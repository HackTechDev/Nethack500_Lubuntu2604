# Cinquième lot : messages sur les stims, puces, implants, modules,
# logiciels et la monnaie

msgctxt "quest"
msgid "\"Can you spare an old cutpurse a zorkmid for some grog?\""
msgstr "« Tu n'aurais pas un eddie pour un vieux coupe-bourse qui a soif ? »"

msgctxt "quest"
msgid "\"Gehennom on 5 zorkmids a day -- more like 500 a day if you ask me.\""
msgstr "« La Géhennom pour 5 eddies par jour -- plutôt 500 par jour, si tu veux mon avis. »"

msgctxt "quest"
msgid "\"Hey man, got any potions of hallucination for sale?\""
msgstr "« Dis donc, t'aurais pas des stims d'hallucination à vendre ? »"

msgctxt "quest"
msgid "\"I shall use your very skin to bind my next grimoire.\""
msgstr "« Je tannerai ta propre peau pour gainer mon prochain terminal. »"

msgctxt "quest"
msgid "\"I will put my %Rp to work making a physic out of your ashes.\""
msgstr "« Je mettrai mes %Rp au travail pour tirer un stim de tes cendres. »"

msgid "As you cogitate the formula on it, the scroll disappears."
msgstr "Tandis que vous méditez son code, la puce grille."

msgid "As you pronounce the formula on it, the scroll disappears."
msgstr "Tandis que vous exécutez son code, la puce grille."

msgid "As you read the scroll, it disappears."
msgstr "Pendant que vous lisez la puce, elle grille."

msgid "Some potions spill out."
msgstr "Des stims s'en échappent."

msgid "The ink in this spellbook is %s."
msgstr "Le code de ce logiciel est %s."

msgid "The potion explodes!"
msgstr "Le stim explose !"

msgid "The scroll turns to dust as you pick it up."
msgstr "La puce tombe en poussière quand vous la ramassez."

msgid "The scrolls turn to dust as you pick them up."
msgstr "Les puces tombent en poussière quand vous les ramassez."

msgid "There is a message on this scroll."
msgstr "Il y a un message sur cette puce."

msgid "This spellbook has nothing written in it."
msgstr "Ce logiciel est vide."

msgid "You cannot take off your %s to remove the ring."
msgstr "Vous ne pouvez pas retirer vos %s pour retirer le module."

msgid "You cogitate the formula on the scroll."
msgstr "Vous méditez le code de la puce."

