msgctxt "quest"
msgid "[%nC dies without honor.]"
msgstr "[%nC meurt sans honneur.]"

#, no-c-format
msgctxt "quest"
msgid "[%nC dies.  Moloch is aware of you and angry at %n.]"
msgstr "[%nC meurt.  Moloch sait que vous êtes là et il est furieux contre %n.]"

#, no-c-format
msgctxt "quest"
msgid "[%nC dies.]"
msgstr "[%nC meurt.]"

#, no-c-format
msgctxt "quest"
msgid "[%nC has stolen %o.  Infiltrate %i and retrieve %oh for us.]"
msgstr "[%nC a volé %o.  Infiltrez-vous dans %i et reprenez-le pour nous.]"

#, no-c-format
msgctxt "quest"
msgid "[%nC has stolen %o.  Locate %i, defeat %ni, and return %O.]"
msgstr "[%nC a volé %o.  Trouvez %i, vainquez %ni et rapportez %O.]"

