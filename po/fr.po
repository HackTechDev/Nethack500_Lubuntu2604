msgstr "Les barreaux de fer fondent un peu mais restent intacts."

msgid "The iron bars melt."
msgstr "Les barreaux de fer fondent."

msgid "The leash slips loose."
msgstr "La laisse se détache."

msgid "The leash snaps loose."
msgstr "La laisse casse."

#, c-format
msgid "The massive hammer hits!  Lightning strikes %s!"
msgstr "Le marteau massif frappe !  La foudre s'abat sur %s !"

msgid "The massive hammer hits!  Lightning strikes you!"
msgstr "Le marteau massif frappe !  La foudre s'abat sur vous !"

msgid "The mixture bubbles, then clears."
msgstr "Le mélange bouillonne, puis devient limpide."

