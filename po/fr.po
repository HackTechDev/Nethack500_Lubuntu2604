#: dat/nhlib.lua:231
#, lua-format
msgid "Looks like you're getting hungry.  You'll starve to death, unless you eat something."
msgstr "On dirait que vous commencez à avoir faim.  Vous mourrez de faim si vous ne mangez rien."

#: dat/nhlib.lua:232
#, lua-format
msgid "Comestibles are eaten with '%s'"
msgstr "On mange les aliments avec “%s”"

#: dat/tut-1.lua:24
#, lua-format
msgid "Note: Outside the tutorial, Ctrl-key combinations are shown prefixed with a caret, like '^%s'"
msgstr "Note : hors du tutoriel, les combinaisons avec Ctrl s'écrivent précédées d'un accent circonflexe, comme « ^%s »"

#: dat/tut-1.lua:80
#, lua-format
msgid "Move around with %s"
msgstr "Déplacez-vous avec %s"

#: dat/tut-1.lua:81
#, lua-format
msgid "Move diagonally with %s"
msgstr "Déplacez-vous en diagonale avec %s"

#: dat/tut-1.lua:84
#, lua-format
msgid "Knights can jump with '%s'"
msgstr "Les chevaliers peuvent sauter avec “%s”"

#: dat/tut-1.lua:89
#, lua-format
msgid "Some actions may require multiple tries before succeeding"
msgstr "Certaines actions demandent plusieurs essais avant de réussir"

#: dat/tut-1.lua:90
#, lua-format
msgid "Open the door by moving into it"
msgstr "Ouvrez la porte en avançant dedans"

#: dat/tut-1.lua:93
#, lua-format
msgid "Close the door with '%s'"
msgstr "Fermez la porte avec “%s”"

#: dat/tut-1.lua:98
#, lua-format
msgid "You can leave the tutorial via the magic portal."
msgstr "Vous pouvez quitter le tutoriel par le portail magique."

#: dat/tut-1.lua:103
#, lua-format
msgid "This door is locked. Kick it with '%s'"
msgstr "Cette porte est verrouillée. Donnez-lui un coup de pied avec “%s”"

#: dat/tut-1.lua:110
#, lua-format
msgid "Look around the map with '%s', press ESC when you're done"
msgstr "Examinez la carte avec “%s”, appuyez sur Échap quand vous avez fini"

#: dat/tut-1.lua:114
#, lua-format
msgid "Use '%s' to search for secret doors"
msgstr "Utilisez “%s” pour chercher les portes secrètes"

#: dat/tut-1.lua:116
#, lua-format
msgid "Wrong secret"
msgstr "Mauvais secret"

#: dat/tut-1.lua:120
#, lua-format
msgid "Behind this door is a dark corridor"
msgstr "Derrière cette porte se trouve un couloir sombre"

#: dat/tut-1.lua:128
#, lua-format
msgid "There are four traps next to you! Search for them."
msgstr "Il y a quatre pièges à côté de vous ! Cherchez-les."

#: dat/tut-1.lua:136
#, lua-format
msgid "Some traps can be disabled with '%s'"
msgstr "Certains pièges peuvent être désamorcés avec “%s”"

#: dat/tut-1.lua:143
#, lua-format
msgid "Pick up items with '%s'"
msgstr "Ramassez les objets avec “%s”"

#: dat/tut-1.lua:149
#, lua-format
msgid "Wear armor with '%s'"
msgstr "Portez une armure avec “%s”"

#: dat/tut-1.lua:153
#, lua-format
msgid "Wield weapons with '%s'"
msgstr "Maniez une arme avec “%s”"

#: dat/tut-1.lua:156
#, lua-format
msgid "Hit monsters by walking into them."
msgstr "Frappez les monstres en avançant vers eux."

#: dat/tut-1.lua:162
#, lua-format
msgid "Now you know the very basics. You can leave the tutorial via the magic portal."
msgstr "Vous connaissez maintenant les bases. Vous pouvez quitter le tutoriel par le portail magique."

#: dat/tut-1.lua:164
#, lua-format
msgid "Step into this portal to leave the tutorial"
msgstr "Entrez dans ce portail pour quitter le tutoriel"

#: dat/tut-1.lua:169
#, lua-format
msgid "Push boulders by moving into them"
msgstr "Poussez les rochers en avançant vers eux"

#: dat/tut-1.lua:174
#, lua-format
msgid "Take off armor with '%s'"
msgstr "Ôtez une armure avec “%s”"

#: dat/tut-1.lua:179
#, lua-format
msgid "Some items have shuffled descriptions, different each game"
msgstr "Certains objets ont des descriptions mélangées, différentes à chaque partie"

#: dat/tut-1.lua:180
#, lua-format
msgid "Pick up this scroll, read it with '%s', and try to remove the armor again"
msgstr "Ramassez ce parchemin, lisez-le avec “%s”, puis essayez de nouveau d'ôter l'armure"

#: dat/tut-1.lua:184
#, lua-format
msgid "Another magic portal, a way to leave this tutorial"
msgstr "Un autre portail magique, pour quitter ce tutoriel"

#: dat/tut-1.lua:199
#, lua-format
msgid "Avoid being burdened, it slows you down"
msgstr "Évitez d'être chargé, cela vous ralentit"

#: dat/tut-1.lua:200
#, lua-format
msgid "Drop items with '%s'"
msgstr "Posez des objets avec “%s”"

#: dat/tut-1.lua:201
#, lua-format
msgid "You can drop partial stacks by prefixing the item slot letter with a number"
msgstr "Pour poser une partie d'un tas, tapez un nombre avant la lettre de l'objet"

#: dat/tut-1.lua:207
#, lua-format
msgid "Throw items with '%s'"
msgstr "Lancez des objets avec “%s”"

#: dat/tut-1.lua:215
#, lua-format
msgid "Missiles, such as rocks, work better when fired from appropriate launcher"
msgstr "Les projectiles, comme les pierres, sont plus efficaces tirés avec le lanceur adapté"

#: dat/tut-1.lua:218
#, lua-format
msgid "Wield the sling"
msgstr "Maniez la fronde"

#: dat/tut-1.lua:219
#, lua-format
msgid "Use '%s' to fire missiles with the wielded launcher"
msgstr "Utilisez “%s” pour tirer des projectiles avec le lanceur en main"

#: dat/tut-1.lua:221
#, lua-format
msgid "Firing launches items from your quiver; Use '%s' to put items in it"
msgstr "Tirer lance les objets de votre carquois ; utilisez “%s” pour y mettre des objets"

#: dat/tut-1.lua:223
#, lua-format
msgid "You can wait a turn with '%s'"
msgstr "Vous pouvez attendre un tour avec “%s”"

#: dat/tut-1.lua:230
#, lua-format
msgid "You loot containers with '%s'"
msgstr "Vous fouillez les conteneurs avec “%s”"

#: dat/tut-1.lua:236
#, lua-format
msgid "Containers can also be emptied with '%s'"
msgstr "On peut aussi vider les conteneurs avec “%s”"

#: dat/tut-1.lua:238
#, lua-format
msgid "Magic wands are used with '%s'"
msgstr "On utilise les baguettes magiques avec “%s”"

#: dat/tut-1.lua:243
#, lua-format
msgid "You can run by prefixing a movement key with '%s'"
msgstr "Vous pouvez courir en tapant “%s” avant une touche de déplacement"

#: dat/tut-1.lua:248
#, lua-format
msgid "Travel across the level with '%s'"
msgstr "Voyagez à travers le niveau avec “%s”"

#: dat/tut-1.lua:256
#, lua-format
msgid "Use '%s' to eat edible things"
msgstr "Utilisez “%s” pour manger ce qui se mange"

#: dat/tut-1.lua:267
#, lua-format
msgid "Use '%s' to use two weapons at once"
msgstr "Utilisez “%s” pour manier deux armes à la fois"

#: dat/tut-1.lua:271
#, lua-format
msgid "Swap weapons quickly with '%s'"
msgstr "Échangez vite vos armes avec “%s”"

#: dat/tut-1.lua:279
#, lua-format
msgid "Put on accessories with '%s'"
msgstr "Mettez des accessoires avec “%s”"

#: dat/tut-1.lua:281
#, lua-format
msgid "Remove accessories with '%s'"
msgstr "Retirez des accessoires avec “%s”"

#: dat/tut-1.lua:288
#, lua-format
msgid "Use '%s' to go down the stairs"
msgstr "Utilisez “%s” pour descendre l'escalier"

#: dat/tut-1.lua:296
#, lua-format
msgid "UNDER CONSTRUCTION"
msgstr "EN CONSTRUCTION"

#: dat/tut-1.lua:304
#, lua-format
msgid "Can't get through?  You're carrying too much."
msgstr "Vous ne passez pas ?  Vous portez trop de choses."

#: dat/tut-1.lua:315
#, lua-format
msgid "Spellcasting"
msgstr "Lancer des sorts"

#: dat/tut-1.lua:319
#, lua-format
msgid "Unfortunately you don't have enough energy to cast spells."
msgstr "Malheureusement, vous n'avez pas assez d'énergie pour lancer des sorts."

#: dat/tut-1.lua:321
#, lua-format
msgid "Pick up the spellbook with '%s'"
msgstr "Ramassez le grimoire avec “%s”"

#: dat/tut-1.lua:323
#, lua-format
msgid "Read the spellbook with '%s'"
msgstr "Lisez le grimoire avec “%s”"

#: dat/tut-1.lua:324
#, lua-format
msgid "Use '%s' to cast a spell"
msgstr "Utilisez “%s” pour lancer un sort"

#: dat/tut-1.lua:329
#, lua-format
msgid "You \"quaff\" potions with '%s'"
msgstr "Vous buvez les potions avec “%s”"

#: dat/tut-2.lua:22
#, lua-format
msgid "Use '%s' to go up the stairs"
msgstr "Utilisez “%s” pour monter l'escalier"

