msgctxt "quest"
msgid "[%nC curses at you as %nh dies.]"
msgstr "[%nC vous maudit en mourant.]"

#, no-c-format
msgctxt "quest"
msgid "[%nC curses you as %nh dies.]"
msgstr "[%nC vous maudit en mourant.]"

