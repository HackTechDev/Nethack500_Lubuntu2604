msgctxt "quest"
msgid "[Are you stupid or are you ready?]"
msgstr "[Tu es stupide ou tu es prêt{|e} ?]"

#, no-c-format
msgctxt "quest"
msgid "[Are you truly a samurai?]"
msgstr "[Êtes-vous vraiment samouraï ?]"

