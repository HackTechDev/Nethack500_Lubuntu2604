#: src/allmain.c:59
msgid "You are lucky!  Full moon tonight."
msgstr "Vous avez de la chance ! C'est la pleine lune ce soir."

#: src/allmain.c:62
msgid "Be careful!  New moon tonight."
msgstr "Prudence ! C'est la nouvelle lune ce soir."

#: src/allmain.c:66
msgid "Watch out!  Bad things can happen on Friday the 13th."
msgstr "Attention ! Il peut arriver malheur un vendredi 13."

#: src/options.c:446
#, c-format
msgid "Put \"OPTIONS=!tutorial\" in %s to skip this query."
msgstr "Mettez « OPTIONS=!tutorial » dans %s pour ne plus avoir cette question."

#: src/options.c:447
msgid "your configuration file"
msgstr "votre fichier de configuration"

#: src/options.c:455
msgid "Yes, do a tutorial"
msgstr "Oui, faire le tutoriel"

#: src/options.c:459
msgid "No, just start play"
msgstr "Non, commencer à jouer"

#: src/options.c:464
msgid "(Please choose 'y' or 'n'.)"
msgstr "(Veuillez choisir « y » ou « n ».)"

#: src/options.c:466
msgid "Do you want a tutorial?"
msgstr "Voulez-vous faire le tutoriel ?"
